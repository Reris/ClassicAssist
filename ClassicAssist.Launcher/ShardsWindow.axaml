<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:launcher="clr-namespace:ClassicAssist.Launcher" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Launcher.ShardsWindow" Foreground="{DynamicResource ThemeForegroundBrush}" mc:Ignorable="d" x:Name="Window" Background="{DynamicResource ThemeBackgroundBrush}" Title="{x:Static properties:Resources.Shards}" Height="600" Width="720" WindowStartupLocation="CenterScreen" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:properties="clr-namespace:ClassicAssist.Launcher.Properties">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:InverseBooleanValueConverter x:Key="InverseBooleanConverter" />
            <valueConverters:BooleanToOpacityValueConverter x:Key="BooleanToOpacityValueConverter" />
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles />
    <Window.DataContext>
        <launcher:ShardsViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10, 5, 0,0" Classes="ToolBarStyle1">
            <Button Height="24" Margin="0,0,5,0" Command="{Binding AddCommand, Mode=OneWay}">
                <Image Source="{DynamicResource AddIcon}" Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityValueConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" ToolTip.Tip="{x:Static properties:Resources.Add}" />
            </Button>
            <Button Height="24" Command="{Binding RemoveCommand, Mode=OneWay}" CommandParameter="{Binding SelectedShard}">
                <Image Source="{DynamicResource RemoveIcon}" Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityValueConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" ToolTip.Tip="{x:Static properties:Resources.Remove}" />
            </Button>
            <Button Height="24" Command="{Binding RefreshCommand}" CommandParameter="{Binding SelectedShard}">
                <Image Source="{DynamicResource RefreshIcon}" Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityValueConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" ToolTip.Tip="{x:Static properties:Resources.Refresh}" />
            </Button>
        </StackPanel>
        <DataGrid x:Name="listView" Grid.Row="1" SelectedItem="{Binding SelectedShard}" Margin="10,5,10,10" ItemsSource="{Binding ShardManager.VisibleShards}" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <Interaction.Behaviors>
                <behaviours:GridViewSort ComparerType="{x:Type launcher:ShardListViewComparer}" />
            </Interaction.Behaviors>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.Shard}" SortMemberPath="Name" Width="206">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="launcher:ShardEntry">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" CanEdit="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}" Width="{Binding ActualWidth, ElementName=NameColumn, Converter={StaticResource CellWidthValueConverter}}" Grid.Column="0" />
                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Command="{Binding Path=DataContext.OpenWebsiteCommand, ElementName=Window}" CommandParameter="{Binding}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Website}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                            <Style Selector="^.ca-dt1">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                        </Style>
                                    </Button.Styles>
                                    <Image Source="{DynamicResource WebIcon}" Height="16" ToolTip.Tip="{x:Static properties:Resources.Open_Shard_Website}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.Address}" SortMemberPath="Address" Width="186">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="launcher:ShardEntry">
                            <controls:EditTextBlock Text="{Binding Address, Mode=TwoWay}" CanEdit="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}" Width="{Binding ActualWidth, ElementName=AddressColumn, Converter={StaticResource CellWidthValueConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.Port}" SortMemberPath="Port" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="launcher:ShardEntry">
                            <controls:EditTextBlock Text="{Binding Port, Mode=TwoWay}" CanEdit="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}" Width="{Binding ActualWidth, ElementName=PortColumn, Converter={StaticResource CellWidthValueConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.Encryption}" SortMemberPath="Encryption" Width="81">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="launcher:ShardEntry">
                            <CheckBox IsChecked="{Binding Encryption}" IsEnabled="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static properties:Resources.Players}" Binding="{Binding Status}" SortMemberPath="Status" Width="81" />
                <DataGridTextColumn Header="{x:Static properties:Resources.Ping}" Binding="{Binding Ping}" SortMemberPath="Ping" Width="56" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.Open_a_GitHub_issue_to_have_your_shard_added_to_the_list_}" Click="GitHubIssueLink_OnClick" />
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,10">
                <Button Content="{x:Static properties:Resources.OK}" Margin="0,0,10,0" Command="{Binding OKCommand, Mode=OneWay}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
                <Button Content="{x:Static properties:Resources.Cancel}" Command="{Binding CancelCommand, Mode=OneWay}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
