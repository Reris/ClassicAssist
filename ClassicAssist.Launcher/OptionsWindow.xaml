<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.Launcher" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Launcher.OptionsWindow" mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeBackgroundBrush}" Title="{x:Static properties:Resources.Options}" Height="400" Width="400" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:properties="clr-namespace:ClassicAssist.Launcher.Properties">
    <Window.DataContext>
        <local:OptionsViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Margin="10" Grid.Row="0" Header="{x:Static properties:Resources.Additional_Plugins_}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="listBox" Grid.Row="1" SelectedItem="{Binding SelectedPlugin}" DisplayMemberBinding="{Binding Name}" ItemsSource="{Binding Plugins}" ToolTip.Tip="{Binding SelectedItem.FullPath, ElementName=listBox}" />
                <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{x:Static properties:Resources.Add}" Command="{Binding AddPluginCommand}" Margin="0,0,10,0" />
                    <Button Content="{x:Static properties:Resources.Remove}" Command="{Binding RemovePluginCommand}" CommandParameter="{Binding SelectedItem, ElementName=listBox}" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Header="{x:Static properties:Resources.Options}" Grid.Row="1" Margin="10,0,10,10">
            <StackPanel Margin="10">
                <CheckBox Content="{x:Static properties:Resources.Debug}" IsChecked="{Binding ClassicOptions.Debug}" />
                <CheckBox Content="{x:Static properties:Resources.Autologin}" IsChecked="{Binding ClassicOptions.Autologin}" />
                <CheckBox Content="{x:Static properties:Resources.Skip_Login_Screen}" IsChecked="{Binding ClassicOptions.SkipLoginScreen}" />
                <CheckBox Content="{x:Static properties:Resources.Auto_Reconnect}" IsChecked="{Binding ClassicOptions.AutoReconnect}" />
                <StackPanel Orientation="Horizontal">
                    <Label Content="{x:Static properties:Resources.Reconnect_Time}" Margin="0,0,10,0" Padding="0" />
                    <TextBox MinWidth="80" Text="{Binding ClassicOptions.ReconnectTime, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Content="{x:Static properties:Resources.Override_Client_Version}" IsChecked="{Binding ClassicOptions.OverrideClientVersion}" />
                <StackPanel Orientation="Horizontal">
                    <Label Content="{x:Static properties:Resources.Client_Version}" Margin="0,0,10,0" Padding="0" />
                    <TextBox MinWidth="80" Text="{Binding ClassicOptions.ClientVersion, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="10,0,10,10">
            <Button Content="{x:Static properties:Resources.OK}" Margin="0,0,10,0" Command="{Binding OKCommand, Mode=OneWay}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static properties:Resources.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
