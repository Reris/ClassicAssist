<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.Launcher" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Launcher.MainWindow" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" Title="{x:Static properties:Resources.ClassicAssist_Launcher}" Width="500" WindowStartupLocation="CenterScreen" SizeToContent="Height" CanResize="False" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:properties="clr-namespace:ClassicAssist.Launcher.Properties">
    <Interaction.Behaviors>
        <behaviours:WindowClosingBehaviour Command="{Binding ClosingCommand}" />
    </Interaction.Behaviors>
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.Styles>
            <Style Selector="GroupBox">
                <Setter Property="Padding" Value="5" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
        </Grid.Styles>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Header="{x:Static properties:Resources.Client_Options}" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="0,0,5,0" SelectedItem="{Binding SelectedClientPath}" ItemsSource="{Binding ClientPaths}" />
                <Button Content="…" Grid.Column="1" Padding="10,0,10,0" Command="{Binding SelectClientPathCommand, Mode=OneWay}" />
            </Grid>
        </GroupBox>
        <GroupBox Header="{x:Static properties:Resources.Ultima_Online}" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="0,0,5,0" SelectedItem="{Binding SelectedDataPath}" ItemsSource="{Binding DataPaths}" />
                <Button Content="…" Grid.Column="1" Padding="10,0,10,0" Command="{Binding SelectDataPathCommand, Mode=OneWay}" />
            </Grid>
        </GroupBox>
        <GroupBox Header="{x:Static properties:Resources.Shard}" Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox DockPanel.Dock="Left" Margin="0,0,5,0" Height="33" SelectedItem="{Binding SelectedShard}" DisplayMemberBinding="{Binding Name}" Grid.Column="0" ItemsSource="{Binding ShardManager.VisibleShards}" />
                <Button Content="{x:Static properties:Resources.Shards}" Grid.Column="1" Command="{Binding ShowShardsWindowCommand, Mode=OneWay}" />
            </Grid>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Stretch">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="0,0,5,0" />
                </Style>
                <Style Selector="Image">
                    <Setter Property="Margin" Value="0,3,10,3" />
                    <Setter Property="Height" Value="16" />
                </Style>
            </StackPanel.Styles>
            <Button Command="{Binding StartCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource PlayIcon}" />
                    <TextBlock Text="{x:Static properties:Resources.Start}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CheckForUpdateCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource RefreshIcon}" />
                    <TextBlock Text="{x:Static properties:Resources.Check_for_update}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OptionsCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource OptionsIcon}" />
                    <TextBlock Text="{x:Static properties:Resources.Options}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
