<UserControl xmlns="https://github.com/avaloniaui" xmlns:avalonedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:browser="clr-namespace:ClassicAssist.Browser" xmlns:controls2="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:headered="clr-namespace:ClassicAssist.Controls.Headered;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Browser.MacroBrowserControl" mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="900" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:data="clr-namespace:ClassicAssist.Browser.Data" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary />
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.xaml" />
        <StyleInclude Source="avares://ClassicAssist/Resources/LeftRightIconToggleButton.xaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <browser:MacroBrowserViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,5,10,5">
                <Grid.Styles>
                    <Style Selector="headered|HorizontalHeaderedContentControl">
                        <Setter Property="Margin" Value="0,0,10,0" />
                    </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <headered:HorizontalHeaderedContentControl Header="{x:Static resources:Strings.Shard}" Grid.Column="0">
                    <controls2:ClearableComboBox ClearCommand="{Binding ClearCommand}" ClearCommandParameter="{x:Static data:FilterType.Shard}" SelectedItem="{Binding ShardFilter}" ItemsSource="{Binding Shards}" />
                </headered:HorizontalHeaderedContentControl>
                <headered:HorizontalHeaderedContentControl Header="{x:Static resources:Strings.Era}" Grid.Column="1">
                    <controls2:ClearableComboBox ClearCommand="{Binding ClearCommand}" ClearCommandParameter="{x:Static data:FilterType.Era}" SelectedItem="{Binding EraFilter}" ItemsSource="{Binding Eras}" />
                </headered:HorizontalHeaderedContentControl>
                <headered:HorizontalHeaderedContentControl Header="{x:Static resources:Strings.Author}" Grid.Column="2">
                    <controls2:ClearableComboBox ClearCommand="{Binding ClearCommand}" ClearCommandParameter="{x:Static data:FilterType.Author}" SelectedItem="{Binding AuthorFilter}" ItemsSource="{Binding Authors}" />
                </headered:HorizontalHeaderedContentControl>
                <headered:HorizontalHeaderedContentControl Header="{x:Static resources:Strings.Category}" Margin="0" Grid.Column="3">
                    <controls2:ClearableComboBox ClearCommand="{Binding ClearCommand}" ClearCommandParameter="{x:Static data:FilterType.Category}" SelectedItem="{Binding CategoryFilter}" ItemsSource="{Binding Categories}" />
                </headered:HorizontalHeaderedContentControl>
            </Grid>
            <Grid Grid.Row="1" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" /><!-- MIGRATION: collapse trigger on ColumnDefinition removed -->
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="listBox" Grid.Column="0" Grid.Row="0" SelectedItem="{Binding SelectedItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Macros}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap">
                        <Button Content="{x:Static resources:Strings.Learn_how_to_contribute_your_own_macros___}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Click="Hyperlink_Click" />
                    </TextBlock>
                </Grid>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <avalonedit:TextEditor ShowLineNumbers="True" x:Name="CodeTextEditor" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="10,0,0,0" IsReadOnly="True">
                        <Interaction.Behaviors>
                            <behaviours:AvalonEditBehaviour TextBinding="{Binding SelectedItem.Macro}" />
                        </Interaction.Behaviors>
                    </avalonedit:TextEditor>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,0,0">
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                        </WrapPanel.Styles>
                        <ToggleButton x:Name="ToggleButton" Height="15" Margin="0" VerticalAlignment="Center" Classes="LeftRightIconToggleButton" />
                        <Button Content="{x:Static resources:Strings.Copy_to_clipboard}" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedItem}" />
                        <Button Content="{x:Static resources:Strings.Create_Macro}" Command="{Binding CreateMacroCommand}" CommandParameter="{Binding SelectedItem}" />
                        <Button Content="{x:Static resources:Strings.Open_in_Github}" Command="{Binding OpenGithubCommand}" CommandParameter="{Binding SelectedItem, ElementName=listBox}" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Loading}" />
    </Grid>
</UserControl>
