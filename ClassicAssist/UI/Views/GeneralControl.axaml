<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.GeneralControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="500" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:r="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:misc1="clr-namespace:ClassicAssist.UI.Misc" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary />
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <viewModels:GeneralControlViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Margin="5" BorderThickness="1" Header="{x:Static r:Strings.Filters}">
            <Grid>
                <ItemsControl x:Name="listBox" Grid.Row="0" Background="{DynamicResource ThemeInnerControlBackgroundBrush}" ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled}" Grid.Column="0" />
                                <TextBlock Text="{Binding Name}" Margin="5,0,5,0" Grid.Column="1" />
                                <Button Background="Transparent" BorderThickness="0" Grid.Column="2" Command="{Binding DataContext.ConfigureFilterCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay}" Margin="0" Padding="0" ToolTip.Tip="{x:Static r:Strings.Options}" IsVisible="{Binding IsConfigurable}">
                                    <Button.Content>
                                        <Image Source="{DynamicResource configureIcon}" Height="16" Margin="0" />
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </GroupBox>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Header="{x:Static r:Strings.Options}" Grid.Row="0" Margin="5">
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static r:Strings.Always_On_Top}" IsChecked="{Binding CurrentOptions.AlwaysOnTop}" />
                    <CheckBox Content="{x:Static r:Strings.Minimize_to_system_tray}" IsChecked="{Binding Options.SysTray}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <misc:BindingProxy x:Key="proxy" Data="{Binding}" />
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <CheckBox IsChecked="{Binding Options.ActionDelay}" DataContext="{Binding}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="{x:Static r:Strings.Action_Delay_}" Margin="0" />
                                        <TextBox Width="40" Margin="10,0,10,0" Text="{Binding Path=Data.Options.ActionDelayMS, Source={StaticResource proxy}}" />
                                        <Label Content="ms" Margin="0" Padding="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <misc:BindingProxy x:Key="proxy" Data="{Binding}" />
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <CheckBox IsChecked="{Binding Options.DragDelay}" DataContext="{Binding}">
                            <CheckBox.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="{x:Static r:Strings.Action_Delay_Dragging__Sphere_X__}" Margin="0" />
                                        <TextBox Width="40" Margin="10,0,10,0" Text="{Binding Path=Data.Options.DragDelayMS, Source={StaticResource proxy}}" />
                                        <Label Content="ms" Margin="0" Padding="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <Control Grid.Row="1" />
            <Grid Grid.Row="2">
                <GroupBox Header="{x:Static r:Strings.Saved_Passwords_}" Margin="5" Padding="5">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="{x:Static r:Strings.Enabled}" Grid.Column="0" IsChecked="{Binding SavePasswords}" />
                            <ComboBox x:Name="comboBox" Grid.Column="1" Margin="5,0,5,0" SelectedIndex="0" DisplayMemberBinding="{Binding Key}" ItemsSource="{Binding SavedPasswords}" />
                            <Button Content="{x:Static r:Strings.Remove}" Grid.Column="2" Command="{Binding RemoveSavedPasswordCommand}" CommandParameter="{Binding SelectedItem, ElementName=comboBox}" />
                        </Grid>
                        <CheckBox Content="{x:Static r:Strings.Only_overwrite_blank_password}" IsChecked="{Binding SavePasswordsOnlyBlank}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Options.Autologin}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                    <Style Selector="^.ca-dt1">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </Style>
                                </Style>
                            </StackPanel.Styles>
                            <CheckBox Content="{x:Static r:Strings.Autologin}" IsChecked="{Binding Options.Autologin}" />
                            <Button Content="..." Command="{Binding AutologinConfigureCommand}" Margin="5,0,0,0" Padding="10,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="3">
                <GroupBox Header="{x:Static r:Strings.Profiles}" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="5">
                            <ComboBox SelectedItem="{Binding SelectedProfile}" ItemsSource="{Binding Profiles}">
                                <Interaction.Behaviors>
                                    <behaviours:ComboBoxBehavior CommandBinding="{Binding ChangeProfileCommand}" OnlyUserTriggered="True" />
                                </Interaction.Behaviors>
                            </ComboBox>
                        </Grid>
                        <DockPanel Grid.Column="1" Margin="0,5,5,5">
                            <Button Content="{x:Static r:Strings.New}" Margin="0,0,5,0" Padding="10,0,10,0" Command="{Binding NewProfileCommand}" />
                            <Button Content="{x:Static r:Strings.Save}" Margin="0,0,5,0" Padding="10,0,10,0" Command="{Binding SaveProfileCommand}" />
                            <Button Command="{Binding LinkUnlinkProfileCommand}" Padding="4">
                                <Image Width="16" Margin="3,0,3,0">
                                    <Image.Styles>
                                        <Style Selector="Image">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsLinkedProfile}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsLinkedProfile}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                            <Style Selector="^.ca-dt2">
                                                <Setter Property="Source" Value="{DynamicResource unlinkedIcon}" />
                                                <Setter Property="ToolTip.Tip" Value="{x:Static r:Strings.Unlinked}" />
                                            </Style>
                                            <Style Selector="^.ca-dt3">
                                                <Setter Property="Source" Value="{DynamicResource linkedIcon}" />
                                                <Setter Property="ToolTip.Tip" Value="{x:Static r:Strings.Linked}" />
                                            </Style>
                                        </Style>
                                    </Image.Styles>
                                </Image>
                            </Button>
                            <Button Command="{Binding BackupSettingsCommand}" Margin="5,0,0,0" Padding="4">
                                <Image Width="16" Source="{DynamicResource BackupIcon}" ToolTip.Tip="{x:Static r:Strings.Backup_Settings}" />
                            </Button>
                        </DockPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
