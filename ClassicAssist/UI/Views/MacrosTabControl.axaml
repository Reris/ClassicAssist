<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:controls1="clr-namespace:ClassicAssist.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:draggableTreeView="clr-namespace:ClassicAssist.Controls.DraggableTreeView;assembly=ClassicAssist.Controls" xmlns:hotkeys="clr-namespace:ClassicAssist.Data.Hotkeys" xmlns:local="clr-namespace:ClassicAssist.Data.Macros" xmlns:macros="clr-namespace:ClassicAssist.UI.Views.Macros" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:misc1="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.MacrosTabControl" mc:Ignorable="d" d:DesignHeight="500" Padding="5" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <valueConverters:DraggableGroupVisibilityValueConverter x:Key="DraggableGroupVisibilityConverter" />
            <misc1:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <local:MacroEntry x:Key="Macro" Loop="True" Macro="print('hi')" Name="Macro">
                <local:MacroEntry.Hotkey>
                    <hotkeys:ShortcutKeys Key="A" Modifier="LeftAlt" />
                </local:MacroEntry.Hotkey>
                <local:MacroEntry.MacroInvoker>
                    <local:MacroInvoker />
                </local:MacroEntry.MacroInvoker>
            </local:MacroEntry>
            <viewModels:MacrosTabViewModel SelectedItem="{StaticResource Macro}" x:Key="DummyData">
                <viewModels:MacrosTabViewModel.Items>
                    <local:MacroEntry Loop="True" Macro="print('hi')" Name="Macro">
                        <local:MacroEntry.Hotkey>
                            <hotkeys:ShortcutKeys Key="A" Modifier="LeftAlt" />
                        </local:MacroEntry.Hotkey>
                        <local:MacroEntry.MacroInvoker>
                            <local:MacroInvoker />
                        </local:MacroEntry.MacroInvoker>
                    </local:MacroEntry>
                </viewModels:MacrosTabViewModel.Items>
            </viewModels:MacrosTabViewModel>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist/Resources/LeftRightIconToggleButton.xaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <viewModels:MacrosTabViewModel />
    </UserControl.DataContext>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveMacroCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ExecuteCommand}" CommandParameter="{Binding SelectedItem}" />
        <KeyBinding Gesture="F8" Command="{Binding StepCommand}" CommandParameter="{Binding SelectedItem}" />
        <KeyBinding Gesture="F12" Command="{Binding StopCommand}" CommandParameter="{Binding SelectedItem}" />
    </UserControl.KeyBindings>
    <Grid d:DataContext="{StaticResource DummyData}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftColumnWidth}" /><!-- MIGRATION: collapse trigger on ColumnDefinition removed -->
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Interaction.Behaviors>
                <behaviours:GridSizeChangedBehaviour Width="{Binding LeftColumnWidth}" />
            </Interaction.Behaviors>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:FilterControl Grid.Row="0" Margin="0,0,0,5" FilterText="{Binding FilterText}" IsFilterVisible="{Binding IsFilterOpen}">
                    <controls:FilterControl.Styles>
                        <Style Selector="controls|FilterControl">
                            <Setter Property="IsVisible" Value="False" />
                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsFilterOpen}" />
                            <Setter Property="ca:TriggerCondition.Value" Value="True" />
                            <Style Selector="^.ca-dt2">
                                <Setter Property="IsVisible" Value="True" />
                            </Style>
                        </Style>
                    </controls:FilterControl.Styles>
                </controls:FilterControl>
                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Grid.Row="1">
                    <draggableTreeView:DraggableTreeView x:Name="DraggableTreeView" BindableSelectedItem="{Binding SelectedItem, Mode=TwoWay}" BindableSelectedGroup="{Binding SelectedGroup, Mode=TwoWay}" IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" AllowDragGroups="False" AllowDragItemsOntoItems="{Binding CurrentOptions.SortMacrosAlphabetical, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding FilterDraggables}" Classes="CompressedTreeViewStyle">
                        <draggableTreeView:DraggableTreeView.KeyBindings>
                            <KeyBinding Gesture="Ctrl+Delete" Command="{Binding RemoveMacroCommand}" CommandParameter="{Binding SelectedItem}" />
                            <KeyBinding Gesture="Delete" Command="{Binding RemoveMacroConfirmCommand}" CommandParameter="{Binding SelectedItem}" />
                            <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleSearchCommand}" />
                        </draggableTreeView:DraggableTreeView.KeyBindings>
                        <draggableTreeView:DraggableTreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static resources:Strings.New_Group}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:MacrosTabViewModel.NewGroupCommand)}" />
                                <MenuItem Header="{x:Static resources:Strings.Remove_Group}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:MacrosTabViewModel.RemoveGroupCommand)}" CommandParameter="{Binding SelectedGroup}" />
                                <Separator>
                                    <Separator.Styles>
                                        <Style Selector="Separator">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                            <Style Selector="^.ca-dt3">
                                                <Setter Property="IsVisible" Value="False" />
                                            </Style>
                                        </Style>
                                    </Separator.Styles>
                                </Separator>
                                <MenuItem Header="{x:Static resources:Strings.Move_to_group}" ItemsSource="{Binding Draggables}">
                                    <MenuItem.Styles>
                                        <Style Selector="MenuItem">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                            <Style Selector="^.ca-dt4">
                                                <Setter Property="IsVisible" Value="False" />
                                            </Style>
                                        </Style>
                                    </MenuItem.Styles>
                                    <MenuItem.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </MenuItem.ItemTemplate>
<!-- MIGRATION: MenuItem.ItemContainerStyle removed - no Avalonia equivalent -->
                                    </MenuItem>
                            </ContextMenu>
                        </draggableTreeView:DraggableTreeView.ContextMenu>
                        <draggableTreeView:DraggableTreeView.DataTemplates>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="local:MacroGroup">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{DynamicResource GroupIcon}" Grid.Column="0" Height="16" Margin="0,0,5,0" />
                                    <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Grid.Column="1" />
                                </Grid>
                            </TreeDataTemplate>
                            <TreeDataTemplate DataType="local:MacroEntry">
                                <Grid Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" Grid.Column="0" Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=20}">
                                        <controls:EditTextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Global}" />
                                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsRunning}" />
                                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                <Style Selector="^.ca-dt5">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                                <Style Selector="^.ca-dt6">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </Style>
                                        </controls:EditTextBlock.Styles>
                                    </controls:EditTextBlock>
                                    <Image Grid.Column="1" Height="12" Margin="2,0,0,0" Source="{DynamicResource FileIcon}" ToolTip.Tip="{Binding FilePath}">
                                        <Image.Styles>
                                            <Style Selector="Image">
                                                <Setter Property="IsVisible" Value="False" />
                                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsFileBacked}" />
                                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                <Style Selector="^.ca-dt7">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </Style>
                                            </Style>
                                        </Image.Styles>
                                    </Image>
                                    <TextBlock x:Name="Hotkey" Text="{Binding Hotkey}" Margin="2,0,0,0" Grid.Column="2" FontSize="9" Foreground="SpringGreen" TextAlignment="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Hotkey}" />
                                                <Setter Property="ca:TriggerCondition.Value" Value="{x:Static hotkeys:ShortcutKeys.Default}" />
                                                <Style Selector="^.ca-dt8">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </Style>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </Grid>
                            </TreeDataTemplate>
                        </draggableTreeView:DraggableTreeView.DataTemplates>
                        <Interaction.Behaviors>
                            <misc:ScrollOnDragDrop />
                        </Interaction.Behaviors>
                    </draggableTreeView:DraggableTreeView>
                </Border>
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FontSize" Value="10" />
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </Grid.Styles>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,2.5,0" Command="{Binding RemoveMacroConfirmCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=SelectedItem}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                <Style Selector="^.ca-dt9">
                                    <Setter Property="IsEnabled" Value="False" />
                                </Style>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="{x:Static resources:Strings.New}" Grid.Column="1" Margin="2.5,0" Command="{Binding NewMacroCommand, Mode=OneWay}" />
                    <Button Content="{x:Static resources:Strings.Save}" Grid.Column="2" Margin="2.5,0,0,0" Command="{Binding SaveMacroCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
                </Grid>
                <Grid Grid.Row="3" Margin="0,5,0,5">
                    <Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" />
                </Grid>
                <Grid Grid.Row="4" Margin="0,0,0,0">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <valueConverters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Play}" Grid.Column="0" Margin="0,0,2.5,0" Command="{Binding ExecuteCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding SelectedItem.IsRunning, Converter={StaticResource InverseBooleanConverter}, ElementName=DraggableTreeView}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static resources:Strings.Reset_import_cache}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:MacrosTabViewModel.ResetImportCacheCommand)}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{x:Static resources:Strings.Stop}" Grid.Column="1" Margin="2.5,0,0,0" IsEnabled="{Binding SelectedItem.IsRunning}" Command="{Binding StopCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
                </Grid>
                <GroupBox Header="{x:Static resources:Strings.Hotkeys}" Grid.Row="6" Padding="5" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls1:TextBoxKey Shortcut="{Binding Hotkey}" Grid.Row="0" />
                        <CheckBox Content="{x:Static resources:Strings.Pass_to_UO}" Grid.Row="1" Padding="4,-1,0,0" Margin="0,5,0,0" IsChecked="{Binding SelectedItem.PassToUO}" />
                        <Button Content="{x:Static resources:Strings.Clear}" Grid.Row="2" Padding="1,0,1,1" Margin="0,5,0,0" Command="{Binding ClearHotkeyCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
        <Grid Grid.Column="2" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <macros:MacrosCodeTextEditor SelectedItem="{Binding SelectedItem}" Document="{Binding Document}" CaretPosition="{Binding CaretPosition}" IsPerformingAction="{Binding IsPerformingAction}" ClearExceptionCommand="{Binding ClearExceptionCommand}" FormatError="{Binding FormatError}" />
            <WrapPanel Orientation="Horizontal" Grid.Row="2" Margin="5">
                <WrapPanel.Styles>
                    <Style Selector="CheckBox">
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=SelectedItem}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                        <Style Selector="^.ca-dt10">
                            <Setter Property="IsEnabled" Value="False" />
                        </Style>
                    </Style>
                </WrapPanel.Styles>
                <CheckBox Content="{x:Static resources:Strings.Loop}" IsChecked="{Binding SelectedItem.Loop}" />
                <CheckBox Content="{x:Static resources:Strings.Do_not_auto_interupt}" IsChecked="{Binding SelectedItem.DoNotAutoInterrupt}" />
                <CheckBox Content="{x:Static resources:Strings.Run_in_background}" IsChecked="{Binding SelectedItem.IsBackground}" />
                <CheckBox Content="{x:Static resources:Strings.Autostart}" IsChecked="{Binding SelectedItem.IsAutostart}" ToolTip.Tip="{x:Static resources:Strings.When_checked_macro_will_execute_automatically_after_login_}" />
                <CheckBox Content="{x:Static resources:Strings.Undisableable}" IsChecked="{Binding SelectedItem.Disableable, Converter={StaticResource InverseBooleanConverter}}" ToolTip.Tip="{x:Static resources:Strings.Hotkey_will_still_trigger_with_hotkeys_disabled}" />
                <CheckBox Content="{x:Static resources:Strings.Global}" IsChecked="{Binding SelectedItem.Global}" ToolTip.Tip="{x:Static resources:Strings.Loaded_to_all_profiles}" />
            </WrapPanel>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="ToggleButton" Height="15" Grid.Column="0" Margin="0" VerticalAlignment="Bottom" Classes="LeftRightIconToggleButton" />
                <controls1:StretchyWrapPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <controls1:StretchyWrapPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="0,5,5,0" />
                        </Style>
                    </controls1:StretchyWrapPanel.Styles>
                    <Button Content="{x:Static resources:Strings.Object_Inspector}" Command="{Binding InspectObjectCommand, Mode=OneWay}" />
                    <Button Content="{x:Static resources:Strings.Commands}" Command="{Binding ShowCommandsCommand}" />
                    <Button Command="{Binding ShowMacrosWikiCommand}" Padding="5" ToolTip.Tip="{x:Static resources:Strings.Macro_Commands_Wiki__Launches_in_Browser_}">
                        <Image Source="{DynamicResource WebIcon}" Height="16" />
                    </Button>
                    <Button Content="{x:Static resources:Strings.Active_Objects}" Command="{Binding ShowActiveObjectsWindowCommand}" />
                    <Button Command="{Binding ShareMacroCommand}" CommandParameter="{Binding SelectedItem}" Padding="5" ToolTip.Tip="{x:Static resources:Strings.Share_Macro}">
                        <Image Source="{DynamicResource GithubIcon}" Height="16" />
                    </Button>
                    <Button Command="{Binding OpenModulesFolderCommand}" Padding="5" ToolTip.Tip="{x:Static resources:Strings.Open_Modules_Folder}">
                        <Image Source="{DynamicResource ModulesIcon}" Height="16" />
                    </Button>
                    <Button Command="{Binding CreateMacroButtonCommand}" CommandParameter="{Binding SelectedItem}" Padding="5" ToolTip.Tip="{x:Static resources:Strings.Create_Macro_Button}">
                        <Image Source="{DynamicResource AddButtonIcon}" Height="16" />
                    </Button>
                    <Button Command="{Binding FormatCodeCommand}" CommandParameter="{Binding SelectedItem}" Padding="5,0,5,0" ToolTip.Tip="{x:Static resources:Strings.Format_Code}">
                        <Image Source="{DynamicResource AlignLeftIcon}" Height="16" />
                    </Button>
                    <Button Command="{Binding OpenExternalCommand}" CommandParameter="{Binding SelectedItem}" Padding="5,0,5,0" ToolTip.Tip="{x:Static resources:Strings.Open_in_external_editor}">
                        <Image Source="{DynamicResource VSCodeIcon}" Height="16" />
                    </Button>
                    <Button Command="{Binding OpenMacrosFolderCommand}" Padding="5,0,5,0" ToolTip.Tip="{x:Static resources:Strings.Open_Macros_Folder}">
                        <Image Source="{DynamicResource FolderIcon}" Height="16" />
                    </Button>
                </controls1:StretchyWrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
