<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:controls1="clr-namespace:ClassicAssist.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:draggableListBox="clr-namespace:ClassicAssist.Controls.DraggableListBox;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:organizer1="clr-namespace:ClassicAssist.UI.Views.Agents.Organizer" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.Agents.OrganizerTabControl" mc:Ignorable="d" d:DesignHeight="250" d:DesignWidth="500" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:organizer="clr-namespace:ClassicAssist.Data.Organizer" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:local="clr-namespace:ClassicAssist.UI.Views.Agents" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <agents:OrganizerTabViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.Resources>
            <ResourceDictionary>
                <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <ResourceDictionary>
                    <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
                </ResourceDictionary>
            </Grid.Resources>
            <controls1:StretchyWrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="{Binding PlayStopButtonText}" Command="{Binding OrganizeCommand}" CommandParameter="{Binding SelectedItem}">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsOrganizing}" />
                            <Setter Property="ca:TriggerCondition.Value" Value="True" />
                            <Setter Property="ca:TriggerCondition.Key" Value="dt1" />
                            <Style Selector="^.ca-dt1">
                                <Setter Property="Content" Value="{x:Static resources:Strings.Stop}" />
                            </Style>
                        </Style>
                    </Button.Styles>
                </Button>
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static resources:Strings.Stack}" IsChecked="{Binding SelectedItem.Stack}" />
                </StackPanel>
            </controls1:StretchyWrapPanel>
            <Grid Grid.Row="1">
                <draggableListBox:DraggableListBox x:Name="listBox" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}">
                    <draggableListBox:DraggableListBox.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem}" />
                    </draggableListBox:DraggableListBox.KeyBindings>
                    <Interaction.Behaviors>
                        <behaviours:ItemsControlSelectNewEntryBehaviour SelectedItem="{Binding SelectedItem}" Type="{x:Type organizer:OrganizerEntry}" />
                    </Interaction.Behaviors>
                    <draggableListBox:DraggableListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}" />
                            </Grid>
                        </DataTemplate>
                    </draggableListBox:DraggableListBox.ItemTemplate>
                </draggableListBox:DraggableListBox>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <CheckBox Content="{x:Static resources:Strings.Complete}" IsChecked="{Binding SelectedItem.Complete}" />
                <CheckBox Content="{x:Static resources:Strings.Return_Excess}" IsChecked="{Binding SelectedItem.ReturnExcess}">
                    <CheckBox.Styles>
                        <Style Selector="CheckBox">
                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem.Complete}" />
                            <Setter Property="ca:TriggerCondition.Value" Value="False" />
                            <Setter Property="ca:TriggerCondition.Key" Value="dt2" />
                            <Style Selector="^.ca-dt2">
                                <Setter Property="IsEnabled" Value="False" />
                            </Style>
                        </Style>
                    </CheckBox.Styles>
                </CheckBox>
                <Button Content="{x:Static resources:Strings.New}" Margin="0,5,0,0" Command="{Binding NewOrganizerEntryCommand}" />
                <Button Content="{x:Static resources:Strings.Remove}" Margin="0,5,0,0" Command="{Binding RemoveOrganizerAgentEntryCommand}" CommandParameter="{Binding SelectedItem}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <DataGrid x:Name="itemsListView" ItemsSource="{Binding SelectedItem.Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Item}" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="organizer:OrganizerItem">
                                        <controls:EditTextBlock Text="{Binding Item, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ElementName=nameColumn, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static resources:Strings.Graphic}" Binding="{Binding ID, StringFormat=0x\{0:x\}}" Width="106" />
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="organizer:OrganizerItem">
                                        <Grid>
                                            <controls:EditTextBlock Text="{Binding Hue, Mode=TwoWay}" Width="{Binding ActualWidth, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=HueColumn, Mode=OneWay}" ShowIcon="True" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Amount}" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="organizer:OrganizerItem">
                                        <Grid>
                                            <controls:EditTextBlock Text="{Binding Amount, Mode=TwoWay}" Width="{Binding ActualWidth, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=AmountColumn, Mode=OneWay}" ShowIcon="True" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Source}" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="organizer:OrganizerItem">
                                        <organizer1:SourceDestinationOverrideControl Serial="{Binding SourceContainer}" SetCommand="{Binding DataContext.SetEntrySourceContainerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:OrganizerTabControl}}}" SetCommandParameter="{Binding}" ClearCommand="{Binding DataContext.ClearEntrySourceContainerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:OrganizerTabControl}}}" Width="{Binding ActualWidth, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=SourceColumn, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Destination}" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="organizer:OrganizerItem">
                                        <organizer1:SourceDestinationOverrideControl Serial="{Binding DestinationContainer}" SetCommand="{Binding DataContext.SetEntryDestinationContainerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:OrganizerTabControl}}}" SetCommandParameter="{Binding}" ClearCommand="{Binding DataContext.ClearEntryDestinationContainerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:OrganizerTabControl}}}" Width="{Binding ActualWidth, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=DestinationColumn, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5,0,0">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="0,0,5,0" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="{x:Static resources:Strings.Set_Containers}" Command="{Binding SetContainersCommand}" CommandParameter="{Binding SelectedItem}" />
                    <Button Content="{x:Static resources:Strings.Remove}" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=itemsListView}" />
                    <Button Content="{x:Static resources:Strings.Insert}" Command="{Binding InsertItemCommand}" CommandParameter="{Binding SelectedItem}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
