<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:ValueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.ScreenshotTabControl" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ValueConverters:InverseBooleanValueConverter x:Key="InverseBooleanValueConverter" />
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF8A8A8A" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <agents:ScreenshotTabViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="{x:Static resources:Strings.Take_Snapshot}" Margin="0,0,0,5" Command="{Binding TakeSnapshotCommand}" />
            <ListBox x:Name="listBox" Grid.Row="1" ItemsSource="{Binding Screenshots}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Interaction.Behaviors>
                            <behaviours:DoubleClickBehaviour Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" />
                        </Interaction.Behaviors>
                            <Image Source="{Binding BitmapSource.Value}" Width="{Binding ActualWidth, ConverterParameter=32, Converter={StaticResource CellWidthValueConverter}, ElementName=listBox, Mode=OneWay}" Stretch="UniformToFill" />
                            <Border Background="Black" CornerRadius="5" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Opacity="0.8">
                                <TextBlock Text="{Binding Extension}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="{x:Static resources:Strings.Open_Folder}" Margin="0,5,0,0" Command="{Binding OpenFolderCommand}" />
        </Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="{x:Static resources:Strings.Options}">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Styles>
                                <Style Selector="RadioButton">
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                </Style>
                            </StackPanel.Styles>
                            <RadioButton Content="{x:Static resources:Strings.UO_Only}" IsChecked="{Binding Fullscreen, Converter={StaticResource InverseBooleanValueConverter}}" />
                            <RadioButton Content="{x:Static resources:Strings.Fullscreen}" IsChecked="{Binding Fullscreen}" />
                        </StackPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{x:Static resources:Strings.Filename_Format_}" DockPanel.Dock="Left" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding FilenameFormat}" DockPanel.Dock="Right" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="1" Margin="0,5,0,0">
                    <GroupBox.Header>
                        <CheckBox Content="{x:Static resources:Strings.Information_Bar}" IsChecked="{Binding IncludeInfoBar}" />
                    </GroupBox.Header>
                    <StackPanel Margin="5">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IncludeInfoBar}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                <Setter Property="ca:TriggerCondition.Key" Value="dt1" />
                                <Style Selector="^.ca-dt1">
                                    <Setter Property="IsEnabled" Value="False" />
                                </Style>
                            </Style>
                            <Style Selector="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IncludeInfoBar}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                <Setter Property="ca:TriggerCondition.Key" Value="dt2" />
                                <Style Selector="^.ca-dt2">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                                </Style>
                            </Style>
                        </StackPanel.Styles>
                        <DockPanel>
                            <TextBlock Text="{x:Static resources:Strings.Format_}" Margin="0,0,5,0" DockPanel.Dock="Left" />
                            <TextBox Text="{Binding Format}" IsEnabled="{Binding IncludeInfoBar}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{x:Static resources:Strings.Font_Size_}" Margin="0,0,5,0" DockPanel.Dock="Left" />
                            <TextBox Text="{Binding FontSize}" IsEnabled="{Binding IncludeInfoBar}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{x:Static resources:Strings.Font_Color_}" Margin="0,0,5,0" />
                            <Button Command="{Binding SetFontColourCommand}" CommandParameter="{Binding FontColor}">
                                <Image Source="{DynamicResource ColorWheelIcon}" Height="12" Width="12" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{x:Static resources:Strings.Background_Color_}" Margin="0,0,5,0" />
                            <Button Command="{Binding SetBackgroundColourCommand}" CommandParameter="{Binding BackgroundColor}">
                                <Image Source="{DynamicResource ColorWheelIcon}" Height="12" Width="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="2" Margin="0,5,0,0">
                    <GroupBox.Header>
                        <CheckBox Content="{x:Static resources:Strings.Auto_Screenshot}" IsChecked="{Binding AutoScreenshot}" />
                    </GroupBox.Header>
                    <StackPanel Margin="5">
                        <StackPanel.Styles>
                            <Style Selector="CheckBox">
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding AutoScreenshot}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                <Setter Property="ca:TriggerCondition.Key" Value="dt3" />
                                <Style Selector="^.ca-dt3">
                                    <Setter Property="IsEnabled" Value="False" />
                                </Style>
                            </Style>
                            <Style Selector="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding MobileDeath}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                <Setter Property="ca:TriggerCondition.Key" Value="dt4" />
                                <Setter Property="ca:TriggerCondition.Bind2" Value="{Binding AutoScreenshot}" />
                                <Setter Property="ca:TriggerCondition.Value2" Value="False" />
                                <Setter Property="ca:TriggerCondition.Key2" Value="dt5" />
                                <Style Selector="^.ca-dt4">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                                </Style>
                                <Style Selector="^.ca-dt5">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                                </Style>
                            </Style>
                        </StackPanel.Styles>
                        <CheckBox Content="{x:Static resources:Strings.Player_Death}" IsChecked="{Binding PlayerDeath}" />
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,5,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Source="{x:Static resources:Strings.Player_Death_Delay_}" />
                                        <Binding Source="{x:Static resources:Strings._milliseconds_}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding PlayerDeath}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                        <Setter Property="ca:TriggerCondition.Key" Value="dt6" />
                                        <Setter Property="ca:TriggerCondition.Bind2" Value="{Binding AutoScreenshot}" />
                                        <Setter Property="ca:TriggerCondition.Value2" Value="False" />
                                        <Setter Property="ca:TriggerCondition.Key2" Value="dt7" />
                                        <Style Selector="^.ca-dt6">
                                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                                        </Style>
                                        <Style Selector="^.ca-dt7">
                                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                                        </Style>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBox Text="{Binding PlayerDeathDelay}" DockPanel.Dock="Right">
                                <TextBox.Styles>
                                    <Style Selector="TextBox">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding PlayerDeath}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                        <Setter Property="ca:TriggerCondition.Key" Value="dt8" />
                                        <Style Selector="^.ca-dt8">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </Style>
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox Content="{x:Static resources:Strings.Mobile_Death}" IsChecked="{Binding MobileDeath}" Margin="0,0,5,0" />
                            <Button Content="…" Padding="2,0" Command="{Binding ConfigureFilterCommand}" />
                        </StackPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,5,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Source="{x:Static resources:Strings.Mobile_Death_Delay_}" />
                                        <Binding Source="{x:Static resources:Strings._milliseconds_}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBox Text="{Binding MobileDeathDelay}" DockPanel.Dock="Right">
                                <TextBox.Styles>
                                    <Style Selector="TextBox">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding MobileDeath}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                        <Setter Property="ca:TriggerCondition.Key" Value="dt9" />
                                        <Style Selector="^.ca-dt9">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </Style>
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{x:Static resources:Strings.Max_Distance_}" DockPanel.Dock="Left" Margin="0,0,5,0" />
                            <TextBox Text="{Binding Distance}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <CheckBox Content="{x:Static resources:Strings.Only_if_enemy}" Margin="0,5,0,0" IsChecked="{Binding OnlyIfEnemy}" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
