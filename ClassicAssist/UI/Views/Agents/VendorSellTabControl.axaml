<UserControl xmlns="https://github.com/avaloniaui" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.VendorSellTabControl" mc:Ignorable="d" d:DesignWidth="493" d:DesignHeight="400" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:misc1="clr-namespace:ClassicAssist.UI.Misc" xmlns:vendors="clr-namespace:ClassicAssist.Data.Vendors" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style Selector="controls|EditTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <agents:VendorSellTabViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Styles>
            <Style Selector="Button">
                <Setter Property="Padding" Value="4" />
            </Style>
        </Grid.Styles>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="ListBox" Margin="10" Grid.Row="0" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Foreground="Black" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vendors:VendorSellAgentEntry">
                            <CheckBox IsChecked="{Binding Enabled}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static resources:Strings.Graphic}" Binding="{Binding Graphic, StringFormat={}0x{0:x}}" Width="56" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="156" />
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vendors:VendorSellAgentEntry">
                            <controls:EditTextBlock Text="{Binding Hue}" TabIndex="0" Width="{Binding Path=Width, ElementName=HueColumn, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" ShowIcon="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Amount}" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vendors:VendorSellAgentEntry">
                            <controls:EditTextBlock Text="{Binding Amount}" TabIndex="0" Width="{Binding Path=Width, ElementName=AmountColumn, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" ShowIcon="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Min_Price}" Width="106">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vendors:VendorSellAgentEntry">
                            <controls:EditTextBlock Text="{Binding MinPrice}" TabIndex="2" Width="{Binding Path=Width, ElementName=MinPriceColumn, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" ShowIcon="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static resources:Strings.Set_Container}" Command="{Binding SetContainerCommand}" Grid.Column="0" />
            <Image Source="{DynamicResource configureIcon}" Height="16" Grid.Column="1" Margin="10,0,0,0" behaviours:ClickOpensContextMenuBehaviour.Enabled="True">
                <Image.ContextMenu>
                    <ContextMenu IsOpen="False">
                        <MenuItem Header="{x:Static resources:Strings.Reset_Container}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:VendorSellTabViewModel.ResetContainerCommand)}" />
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="5,5,5,5" />
                    <Setter Property="MinWidth" Value="80" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.Insert}" Margin="10">
                <Button.Styles>
                    <Style Selector="Button">
                        </Style>
                </Button.Styles>
                <Button.ContextMenu>
                    <ContextMenu IsOpen="False">
                        <MenuItem Header="{x:Static resources:Strings.ID_from_target}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:VendorSellTabViewModel.InsertCommand)}" />
                        <MenuItem Header="{x:Static resources:Strings.Match_Any_ID}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:VendorSellTabViewModel.InsertMatchAnyCommand)}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="{x:Static resources:Strings.Remove}" Command="{Binding RemoveCommand}" Margin="0,10,10,10" CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        </StackPanel>
    </Grid>
</UserControl>
