<UserControl xmlns="https://github.com/avaloniaui" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.NameOverrideTabControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="500" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:nameOverride="clr-namespace:ClassicAssist.Data.NameOverride" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:HexToIntValueConverter x:Key="HexToIntValueConverter" />
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <agents:NameOverrideTabViewModel />
    </UserControl.DataContext>
    <Grid Margin="10,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,0,10" />
            <DataGrid Grid.Row="1" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✓" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Serial}" Width="106">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="nameOverride:NameOverrideEntry">
                                <controls:EditTextBlock Text="{Binding Serial, Converter={StaticResource HexToIntValueConverter}, StringFormat=0x\{0:x\}}" TabIndex="1" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=SerialColumn}" ShowIcon="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Name}" Width="156">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="nameOverride:NameOverrideEntry">
                                <controls:EditTextBlock Text="{Binding Name}" Label="{Binding Name}" ShowIcon="True" Width="{Binding Path=Width, ElementName=NameColumn, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Notes}" Width="256">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="nameOverride:NameOverrideEntry">
                                <controls:EditTextBlock Text="{Binding Notes}" Label="{Binding Notes}" ShowIcon="True" Width="{Binding Path=Width, ElementName=NotesColumn, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Content="{x:Static resources:Strings.Insert}" Margin="0,5,5,5" Command="{Binding AddCommand}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static resources:Strings.Insert_Empty_Entry}" Command="{Binding Data.AddEmptyCommand, Mode=OneWay, Source={StaticResource Proxy}}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="{x:Static resources:Strings.Remove}" Margin="5" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}" />
            <Button Content="{x:Static resources:Strings.Import}" Margin="5" Command="{Binding ImportCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
