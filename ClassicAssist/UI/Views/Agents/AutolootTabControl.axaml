<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:ValueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:autoloot1="clr-namespace:ClassicAssist.UI.Views.Autoloot" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:behaviours1="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:draggableTreeView="clr-namespace:ClassicAssist.Controls.DraggableTreeView;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:misc1="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.AutolootTabControl" mc:Ignorable="d" d:DesignHeight="250" d:DesignWidth="600" x:Name="userControl" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:autoloot="clr-namespace:ClassicAssist.Data.Autoloot" xmlns:autoloot2="clr-namespace:ClassicAssist.UI.Views.Agents.Autoloot" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <misc1:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <ValueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <ValueConverters:AutolootOperatorFilterValueConverter x:Key="AutolootOperatorFilterValueConverter" />
            <ValueConverters:DraggableGroupVisibilityValueConverter x:Key="DraggableGroupVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <agents:AutolootViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <valueConverters:NullToBooleanConverter x:Key="NullToBooleanValueConverter" />
            </ResourceDictionary>
        </Grid.Resources>
        <Interaction.Behaviors>
            <behaviours1:ClipboardBehaviour CopyCommand="{Binding ClipboardCopyCommand}" PasteCommand="{Binding ClipboardPasteCommand}" CommandParameter="{Binding SelectedProperties}" />
        </Interaction.Behaviors>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftColumnWidth}" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="10" Grid.Column="0">
            <Interaction.Behaviors>
                <behaviours:GridSizeChangedBehaviour Width="{Binding LeftColumnWidth}" />
            </Interaction.Behaviors>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding Enabled}" />
                <CheckBox Content="{x:Static resources:Strings.Disable_inside_guardzone}" IsChecked="{Binding DisableInGuardzone}" />
                <CheckBox Content="{x:Static resources:Strings.Loot_humanoids}" IsChecked="{Binding LootHumanoids}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="{x:Static resources:Strings.Action_Delay_}" Margin="0" Padding="0" VerticalAlignment="Center" />
                    <TextBox Width="40" Margin="10,0,10,0" Text="{Binding ActionDelayMS}" />
                    <Label Content="ms" Margin="0" Padding="0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Grid.Row="1" Margin="0,10,0,10">
                <draggableTreeView:DraggableTreeView x:Name="listView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" AllowDragGroups="False" BindableSelectedItem="{Binding SelectedItem, Mode=TwoWay}" BindableSelectedGroup="{Binding SelectedGroup, Mode=TwoWay}" ItemsSource="{Binding Draggables}" Classes="CompressedTreeViewStyle">
                    <draggableTreeView:DraggableTreeView.DataTemplates>
                        <TreeDataTemplate DataType="autoloot:AutolootEntry">
                            <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" ShowIcon="True" Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=10}">
                                <controls:EditTextBlock.Label>
                                    <MultiBinding StringFormat="{}{0} - 0x{1:x}">
                                        <Binding Path="Name" />
                                        <Binding Path="ID" />
                                    </MultiBinding>
                                </controls:EditTextBlock.Label>
                                <controls:EditTextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Enabled}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=Group.Enabled}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                        <Style Selector="^.ca-dt1">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </Style>
                                        <Style Selector="^.ca-dt2">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </Style>
                                    </Style>
                                </controls:EditTextBlock.Styles>
                            </controls:EditTextBlock>
                        </TreeDataTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" DataType="autoloot:AutolootGroup">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled}" Grid.Column="0" Margin="0,0,5,0" />
                                <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" Grid.Column="1" Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=10}">
                                    <controls:EditTextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Enabled}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                            <Style Selector="^.ca-dt3">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </Style>
                                        </Style>
                                    </controls:EditTextBlock.Styles>
                                </controls:EditTextBlock>
                            </Grid>
                        </TreeDataTemplate>
                    </draggableTreeView:DraggableTreeView.DataTemplates>
                    <draggableTreeView:DraggableTreeView.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}" />
                    </draggableTreeView:DraggableTreeView.KeyBindings>
                    <Interaction.Behaviors>
                        <behaviours1:ItemsControlSelectNewEntryBehaviour SelectedItem="{Binding SelectedItem}" Type="{x:Type autoloot:AutolootEntry}" />
                        <misc:ScrollOnDragDrop />
                    </Interaction.Behaviors>
                    <draggableTreeView:DraggableTreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resources:Strings.New_Group}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.NewGroupCommand)}" />
                            <MenuItem Header="{x:Static resources:Strings.Remove_Group}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.RemoveGroupCommand)}" CommandParameter="{Binding SelectedGroup}" />
                            <Separator>
                                <Separator.Styles>
                                    <Style Selector="Separator">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                        <Style Selector="^.ca-dt4">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                    </Style>
                                </Separator.Styles>
                            </Separator>
                            <MenuItem Header="{x:Static resources:Strings.Move_to_group}" ItemsSource="{Binding Draggables}">
                                <MenuItem.Styles>
                                    <Style Selector="MenuItem">
                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem}" />
                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                        <Style Selector="^.ca-dt5">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                    </Style>
                                </MenuItem.Styles>
                                <MenuItem.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </MenuItem.ItemTemplate>
<!-- MIGRATION: MenuItem.ItemContainerStyle removed - no Avalonia equivalent -->
                            </MenuItem>
                        </ContextMenu>
                    </draggableTreeView:DraggableTreeView.ContextMenu>
                </draggableTreeView:DraggableTreeView>
            </Border>
            <StackPanel Grid.Row="2">
                <Grid>
                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </Grid.Styles>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,5,0" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}" />
                    <Button Content="{x:Static resources:Strings.Insert}" Grid.Column="1" Margin="5,0,0,0">
                        <Button.Styles>
                            <Style Selector="Button">
                                </Style>
                        </Button.Styles>
                        <Button.ContextMenu>
                            <ContextMenu IsOpen="False">
                                <MenuItem Header="{x:Static resources:Strings.ID_from_target}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.InsertCommand)}" />
                                <MenuItem Header="{x:Static resources:Strings.Match_Any_ID}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.InsertMatchAnyCommand)}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Set_Container}" Margin="0,10,5,0" Command="{Binding SetContainerCommand}" Grid.Column="0" />
                    <Image Source="{DynamicResource configureIcon}" Height="16" Margin="5,10,0,0" Grid.Column="1" behaviours1:ClickOpensContextMenuBehaviour.Enabled="True">
                        <Image.ContextMenu>
                            <ContextMenu IsOpen="False">
                                <MenuItem Header="{x:Static resources:Strings.Reset_Container}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.ResetContainerCommand)}" />
                                <MenuItem Header="{x:Static resources:Strings.Define_Custom_Properties}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.DefineCustomPropertiesCommand)}" />
                                <MenuItem Header="{x:Static resources:Strings.CSV_Import}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(agents:AutolootViewModel.CSVImportCommand)}" />
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>
                </Grid>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="0,10" />
        <Grid Grid.Column="2" Margin="10" IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBooleanValueConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="comboBox" Grid.Row="0" DisplayMemberBinding="{Binding Name}" SelectedIndex="0" ItemsSource="{Binding Constraints}" />
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{x:Static resources:Strings.Enabled}" Grid.Column="0" IsChecked="{Binding SelectedItem.Enabled}" />
                <Label Grid.Column="1" Content="{x:Static resources:Strings.Priority_}" HorizontalAlignment="Right" Margin="0,0,5,0" />
                <ComboBox Text="{Binding SelectedItem.Priority, Mode=TwoWay}" Grid.Column="2" ItemsSource="{Binding Source={misc:EnumBindingSource {x:Type autoloot:AutolootPriority}}}" />
            </Grid>
            <DataGrid x:Name="listView1" Grid.Row="2" Margin="0,10,0,10" SelectedItem="{Binding SelectedProperty}" ItemsSource="{Binding SelectedItem.Constraints}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <Interaction.Behaviors>
                    <behaviours1:ListViewMultiSelectionBehaviour SelectedItems="{Binding SelectedProperties}" />
                </Interaction.Behaviors>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Property}" Width="181">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <autoloot1:AutolootPropertyControl DataContext="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Operator}" Width="81">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="autoloot:AutolootConstraintEntry">
                                <ComboBox Width="60" SelectedItem="{Binding Operator}">
                                    <ComboBox.ItemsSource>
                                        <MultiBinding Converter="{StaticResource AutolootOperatorFilterValueConverter}">
                                            <Binding Source="{x:Type autoloot:AutolootOperator}" />
                                            <Binding Path="Property" />
                                        </MultiBinding>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Value}" Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=275}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <autoloot1:AutolootValueControl DataContext="{Binding}" Width="{Binding ElementName=ValueColumn, Path=ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=25}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,5,0" Command="{Binding RemoveConstraintCommand}" CommandParameter="{Binding SelectedProperties}" />
                    <Button Content="{x:Static resources:Strings.Insert}" Grid.Column="1" Margin="5,0,0,0" Command="{Binding InsertConstraintCommand}" CommandParameter="{Binding SelectedValue, ElementName=comboBox}" />
                </Grid>
                <WrapPanel Orientation="Horizontal">
                    <WrapPanel.Styles>
                        <Style Selector="CheckBox">
                            <Setter Property="Margin" Value="0,0,10,0" />
                        </Style>
                    </WrapPanel.Styles>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding SelectedItem.Rehue}">
                            <TextBlock Text="{x:Static resources:Strings.Rehue_matching_items}" VerticalAlignment="Center" />
                        </CheckBox>
                        <Button Margin="0,0,10,0" Command="{Binding SelectHueCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}">
                            <Image Source="{DynamicResource ColorWheelIcon}" Height="12" Width="12" />
                        </Button>
                    </StackPanel>
                    <CheckBox Content="{x:Static resources:Strings.Autoloot_matching_items}" IsChecked="{Binding SelectedItem.Autoloot}" />
                    <CheckBox Content="{x:Static resources:Strings.Requeue_failed_items}" IsChecked="{Binding RequeueFailedItems}" />
                    <CheckBox Content="{x:Static resources:Strings.Match_text_value_of_property__UOAlive_}" IsChecked="{Binding MatchTextValue}" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
