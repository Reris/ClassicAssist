<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:draggableListBox="clr-namespace:ClassicAssist.Controls.DraggableListBox;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.DressTabControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="500" Margin="0" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:dress="clr-namespace:ClassicAssist.Data.Dress" xmlns:misc1="clr-namespace:ClassicAssist.UI.Misc" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <misc:BindingProxy Data="{Binding}" x:Key="Proxy" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <agents:DressTabViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Styles>
            <Style Selector="Button">
                <Setter Property="Padding" Value="4" />
            </Style>
        </Grid.Styles>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Grid Margin="10" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <ResourceDictionary>
                    <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
                </ResourceDictionary>
            </Grid.Resources>
            <CheckBox IsChecked="{Binding MoveConflictingItems}" Grid.Row="0">
                <TextBlock Text="{x:Static resources:Strings.Move_conflicting_items}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Content="{x:Static resources:Strings.Use_UO3D_Packets}" IsChecked="{Binding UseUO3DPackets}" Grid.Row="1" ToolTip.Tip="{x:Static resources:Strings.Requires_Server_Support}" />
            <draggableListBox:DraggableListBox x:Name="listBox1" Grid.Row="2" Margin="0,5" SelectedItem="{Binding SelectedItem}" SelectedIndex="0" ItemsSource="{Binding Items}">
                <draggableListBox:DraggableListBox.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding RemoveDressEntryCommand}" CommandParameter="{Binding SelectedItem}" />
                </draggableListBox:DraggableListBox.KeyBindings>
                <Interaction.Behaviors>
                    <behaviours:ItemsControlSelectNewEntryBehaviour SelectedItem="{Binding SelectedItem}" Type="{x:Type dress:DressAgentEntry}" />
                </Interaction.Behaviors>
                <draggableListBox:DraggableListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ElementName=listBox1, Mode=OneWay}" />
                    </DataTemplate>
                </draggableListBox:DraggableListBox.ItemTemplate>
            </draggableListBox:DraggableListBox>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Command="{Binding RemoveDressEntryCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
                <Button Content="{x:Static resources:Strings.New}" Grid.Column="2" Command="{Binding NewDressEntryCommand, Mode=OneWay}" />
            </Grid>
        </Grid>
        <Grid Margin="10" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="listBox" Grid.Row="0" Margin="0,0,0,5" SelectedItem="{Binding SelectedDressItem}" DisplayMemberBinding="{Binding Name}" ItemsSource="{Binding SelectedItem.Items}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Styles>
                                <Style Selector="MenuItem">
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedDressItem.Type}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="{x:Static dress:DressAgentItemType.ID}" />
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedDressItem.Type}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="{x:Static dress:DressAgentItemType.Serial}" />
                                    <Style Selector="^.ca-dt1">
                                        <Setter Property="IsChecked" Value="True" />
                                    </Style>
                                    <Style Selector="^.ca-dt2">
                                        <Setter Property="IsChecked" Value="False" />
                                    </Style>
                                </Style>
                            </ContextMenu.Styles>
                            <MenuItem Header="{x:Static resources:Strings.Dress_Type}" ToggleType="CheckBox" Command="{Binding Data.ChangeDressTypeCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedDressItem}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <Button Content="{x:Static resources:Strings.Set_Undress_Container}" Grid.Row="1" Command="{Binding SetUndressContainerCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
            </Grid>
        </Grid>
        <Grid Margin="5" Grid.Column="2">
            <Grid.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="0,0,5,5" />
                </Style>
            </Grid.Styles>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Command="{Binding DressAllItemsCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsDressing}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsDressing}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt3">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Stop}" />
                        </Style>
                        <Style Selector="^.ca-dt4">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Dress}" />
                        </Style>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Grid.Row="1" Command="{Binding UndressItemsCommand}" CommandParameter="{Binding SelectedItem}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsUndressing}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsUndressing}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt5">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Stop}" />
                        </Style>
                        <Style Selector="^.ca-dt6">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Undress}" />
                        </Style>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Grid.Row="2" Command="{Binding UndressAllItemsCommand}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsUndressingAll}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsUndressingAll}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt7">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Stop}" />
                        </Style>
                        <Style Selector="^.ca-dt8">
                            <Setter Property="Content" Value="{x:Static resources:Strings.Undress_All}" />
                        </Style>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Content="{x:Static resources:Strings.Import}" Grid.Row="3" Command="{Binding ImportItemsCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
            <Button Content="{x:Static resources:Strings.New_Item}" Grid.Row="4" Command="{Binding AddDressItemCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
            <Button Content="{x:Static resources:Strings.Remove}" Grid.Row="5" Command="{Binding RemoveDressItemCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem, ElementName=listBox}" />
            <Button Content="{x:Static resources:Strings.Clear_All}" Grid.Row="6" Margin="0,10,5,0" Height="25" Command="{Binding ClearDressItemsCommand}" CommandParameter="{Binding SelectedItem}" />
            <Grid Grid.Row="7" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
