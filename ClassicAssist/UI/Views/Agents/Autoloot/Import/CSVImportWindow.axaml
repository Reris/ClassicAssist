<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:folder="clr-namespace:ClassicAssist.UI.ViewModels.Agents.Autoloot.Folder" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.Autoloot.Import.CSVImportWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.CSV_Import}" Height="350" Width="700" Background="{DynamicResource ThemeWindowBackgroundBrush}" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <folder:CSVImportViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox SelectedItem="{Binding SelectedEntry}" Grid.Column="0" ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - 0x{1:x}">
                                    <Binding Path="Name" />
                                    <Binding Path="ID" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DataGrid Margin="10,0" Grid.Column="1" Grid.Row="0" ItemsSource="{Binding SelectedEntry.Constraints}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:Strings.Property}" Binding="{Binding Property.Name}" Width="156" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Operator}" Binding="{Binding Operator}" Width="81" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Value}" Binding="{Binding Value}" Width="156" />
                </DataGrid.Columns>
            </DataGrid>
            <CheckBox IsChecked="{Binding IgnoreDuplicateEntries}" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1" Margin="0,10,0,0" Content="{x:Static resources:Strings.Ignore_duplicate_entries}" />
            <TextBlock Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="2" Margin="0,10,0,0">
                <Button Content="{x:Static resources:Strings.Click_here_to_learn_how_to_use_CSV_Import_}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Click="Hyperlink_OnClick" />
            </TextBlock>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="{x:Static resources:Strings.Select_File}" Command="{Binding SelectFileCommand}" />
            <StackPanel VerticalAlignment="Bottom" Grid.Row="2">
                <Button Content="{x:Static resources:Strings.Import}" Command="{Binding SetImportCommand}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
                <Button Content="{x:Static resources:Strings.Cancel}" Margin="0,5,0,0">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
