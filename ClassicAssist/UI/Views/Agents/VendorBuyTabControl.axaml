<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:ValueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:draggableListBox="clr-namespace:ClassicAssist.Controls.DraggableListBox;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.VendorBuyTabControl" mc:Ignorable="d" d:DesignWidth="493" d:DesignHeight="400" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:vendors="clr-namespace:ClassicAssist.Data.Vendors" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ValueConverters:HexToIntValueConverter x:Key="HexToIntValueConverter" />
            <ValueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <agents:VendorBuyTabViewModel />
    </UserControl.DataContext>
    <Grid Margin="5">
        <Grid.Styles>
            <Style Selector="Button">
                <Setter Property="Padding" Value="4" />
            </Style>
        </Grid.Styles>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="5" Grid.Column="0" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <draggableListBox:DraggableListBox x:Name="listView" Grid.Row="0" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}">
                <draggableListBox:DraggableListBox.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Enabled}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt1">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                        </Style>
                    </Style>
                </draggableListBox:DraggableListBox.Styles>
                <draggableListBox:DraggableListBox.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}" />
                </draggableListBox:DraggableListBox.KeyBindings>
                <draggableListBox:DraggableListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:EditTextBlock Text="{Binding Name, Mode=TwoWay}" Label="{Binding Name}" ShowIcon="True" />
                    </DataTemplate>
                </draggableListBox:DraggableListBox.ItemTemplate>
            </draggableListBox:DraggableListBox>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,5,0" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}" />
                    <Button Content="{x:Static resources:Strings.New}" Grid.Column="1" Margin="5,0,0,0" Command="{Binding InsertCommand}" />
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Margin="5" Grid.Column="1" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <DockPanel.Styles>
                        <Style Selector="CheckBox">
                            <Setter Property="Margin" Value="0,0,20,0" />
                        </Style>
                    </DockPanel.Styles>
                    <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding SelectedItem.Enabled}" />
                    <CheckBox IsChecked="{Binding SelectedItem.IncludeBackpackAmount}" Content="{x:Static resources:Strings.Include_Backpack_Amount}" />
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Row="1">
                    <DataGrid x:Name="ListBox" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" Foreground="Black" ItemsSource="{Binding SelectedItem.Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <CheckBox IsChecked="{Binding Enabled}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Graphic}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding Graphic, Converter={StaticResource HexToIntValueConverter}, StringFormat=0x\{0:x\}}" TabIndex="1" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=ItemIDColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="106" />
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding Hue}" TabIndex="0" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=HueColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Amount}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding Amount}" TabIndex="1" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=AmountColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Max_Price}" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding MaxPrice}" TabIndex="2" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=MaxPriceColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Backpack_Graphic}" Width="106">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding BackpackGraphic, Converter={StaticResource HexToIntValueConverter}, StringFormat=0x\{0:x\}}" TabIndex="1" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=BackpackItemIDColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Item_Weight}" Width="106">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <controls:EditTextBlock Text="{Binding Weight}" TabIndex="1" Width="{Binding Width, ConverterParameter=15, Converter={StaticResource CellWidthValueConverter}, ElementName=WeightColumn}" ShowIcon="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Stackable}" Width="106">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vendors:VendorBuyAgentItem">
                                        <CheckBox IsChecked="{Binding Stackable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="{x:Static resources:Strings.Insert}" MinWidth="80" Command="{Binding InsertEntryCommand, Mode=OneWay}" Margin="0,0,10,0" CommandParameter="{Binding SelectedItem}" />
                    <Button Content="{x:Static resources:Strings.Remove}" MinWidth="80" Command="{Binding RemoveEntryCommand, Mode=OneWay}" CommandParameter="{Binding SelectedEntry}" />
                </StackPanel>
            </Grid>
        </Grid>
        <WrapPanel Orientation="Horizontal" Grid.Row="1" Margin="5,0" Grid.ColumnSpan="2" Grid.Column="0">
            <CheckBox IsChecked="{Binding AutoDisableOnLogin}" Content="{x:Static resources:Strings.Auto_disable_when_loading}" ToolTip.Tip="{x:Static resources:Strings.Disable_all_vendor_buy_entries_on_loading_profile}" />
            <CheckBox IsChecked="{Binding CheckWeight}" Content="{x:Static resources:Strings.Check_Weight}" Margin="10,5" />
            <StackPanel Orientation="Horizontal">
                <Label Content="{x:Static resources:Strings.Minimum_Weight_Available_}" Margin="0,0,10,0" />
                <TextBox MinWidth="100" Text="{Binding MinWeightAvailable}" IsEnabled="{Binding CheckWeight}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding CheckItemCount}" Content="{x:Static resources:Strings.Check_Backpack_Item_Count}" Margin="10,5" />
            <StackPanel Orientation="Horizontal">
                <Label Content="{x:Static resources:Strings.Minimum_Items_Available_}" Margin="0,0,10,0" />
                <TextBox MinWidth="100" Text="{Binding MinItemsAvailable}" IsEnabled="{Binding CheckItemCount}" />
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
