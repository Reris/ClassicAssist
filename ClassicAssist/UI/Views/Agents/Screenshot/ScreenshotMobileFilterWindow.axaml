<Window xmlns="https://github.com/avaloniaui" xmlns:ValueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:screenshot="clr-namespace:ClassicAssist.UI.ViewModels.Agents.Screenshot" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.Screenshot.ScreenshotMobileFilterWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.Screenshot}" Height="450" Width="400" Background="{DynamicResource ThemeWindowBackgroundBrush}" Topmost="True" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:screenshotData="clr-namespace:ClassicAssist.Data.Screenshot" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <ValueConverters:IntToHexStringValueConverter x:Key="IntToHexStringValueConverter" />
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <screenshot:ScreenshotMobileFilterViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10" Classes="ToolBarStyle1">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="Padding" Value="5,0" />
                </Style>
            </StackPanel.Styles>
            <Button Command="{Binding AddCommand}" ToolTip.Tip="{x:Static resources:Strings.Add}">
                <Image Source="{DynamicResource PlusIcon}" Height="16" />
            </Button>
            <Button Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static resources:Strings.Remove}">
                <Image Source="{DynamicResource RemoveIcon}" Height="14" />
            </Button>
            <Button Command="{Binding TargetCommand}" ToolTip.Tip="{x:Static resources:Strings.Target}">
                <Image Source="{DynamicResource CrosshairIcon}" Height="16" />
            </Button>
        </StackPanel>
        <DataGrid Grid.Row="1" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="31">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="screenshotData:ScreenshotMobileFilterEntry">
                            <CheckBox IsChecked="{Binding Enabled}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.ID}" Width="106">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="screenshotData:ScreenshotMobileFilterEntry">
                            <controls:EditTextBlock ShowIcon="True" Foreground="{DynamicResource ThemeForegroundBrush}" Text="{Binding ID, Converter={StaticResource IntToHexStringValueConverter}, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ElementName=idColumn, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Notes}" Width="206">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="screenshotData:ScreenshotMobileFilterEntry">
                            <controls:EditTextBlock ShowIcon="True" Text="{Binding Note, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ElementName=nameColumn, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OkCommand}" Margin="0,0,5,0">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
