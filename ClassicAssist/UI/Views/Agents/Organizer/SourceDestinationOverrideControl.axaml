<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.Agents.Organizer.SourceDestinationOverrideControl" mc:Ignorable="d" d:DesignWidth="100" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.UI.Views.Agents.Organizer" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:IntToHexStringValueConverter x:Key="IntToHexStringValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.axaml" />
    </UserControl.Styles>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static resources:Strings.Default}">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="IsVisible" Value="False" />
                    <Setter Property="(Classes.NoSerial)" Value="{Binding Serial, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}, Converter={x:Static ObjectConverters.IsNull}}" />
                    <Style Selector="^.NoSerial">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
            </TextBlock.Styles>
        </TextBlock>
        <TextBlock Grid.Column="0" Text="{Binding Serial, Converter={StaticResource IntToHexStringValueConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}}">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="(Classes.NoSerial)" Value="{Binding Serial, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}, Converter={x:Static ObjectConverters.IsNull}}" />
                    <Style Selector="^.NoSerial">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </TextBlock.Styles>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Grid.Column="1">
            <controls:ImageButton ImageSource="{DynamicResource CrosshairIcon}" Command="{Binding SetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}}" CommandParameter="{Binding SetCommandParameter, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}}" />
            <controls:ImageButton ImageSource="{DynamicResource RemoveIcon}" Command="{Binding ClearCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}}" CommandParameter="{Binding SetCommandParameter, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SourceDestinationOverrideControl}}}" />
        </StackPanel>
    </Grid>
</UserControl>
