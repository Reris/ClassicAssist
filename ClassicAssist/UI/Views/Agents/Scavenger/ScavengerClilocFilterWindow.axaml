<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:scavenger="clr-namespace:ClassicAssist.UI.ViewModels.Agents.Scavenger" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Agents.Scavenger.ScavengerClilocFilterWindow" x:Name="Window" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" Title="{x:Static resources:Strings.Cliloc_Filter}" Height="450" Width="400" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:scavengerData="clr-namespace:ClassicAssist.Data.Scavenger" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <scavenger:ScavengerClilocFilterViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.Resources>
            <ResourceDictionary>
                <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,0,5" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="31">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="scavengerData:ScavengerClilocFilterEntry">
                            <CheckBox IsChecked="{Binding Enabled}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Cliloc}" Width="81">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="scavengerData:ScavengerClilocFilterEntry">
                            <controls:EditTextBlock ShowIcon="True" Text="{Binding Cliloc, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ElementName=nameColumn, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static resources:Strings.Property}" Binding="{Binding Property}" Width="186" />
                <DataGridTemplateColumn Header="+/-" Width="81">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.AddCommand, ElementName=Window}" Padding="3">
                                    <Image Source="{DynamicResource PlusIcon}" Height="8" />
                                </Button>
                                <Button Command="{Binding DataContext.RemoveCommand, ElementName=Window}" Margin="5,0,0,0" Padding="3" CommandParameter="{Binding Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}">
                                    <Image Source="{DynamicResource MinusIcon}" Height="8" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OkCommand}" Margin="0,0,5,0">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
