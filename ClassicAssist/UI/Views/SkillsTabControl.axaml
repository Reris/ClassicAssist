<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.SkillsTabControl" mc:Ignorable="d" xmlns:data="clr-namespace:ClassicAssist.UO.Data" xmlns:misc1="clr-namespace:ClassicAssist.UI.Misc" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:sharedResources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:skills="clr-namespace:ClassicAssist.Data.Skills" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </UserControl.Styles>
    <d:DesignerProperties.DesignStyle>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </d:DesignerProperties.DesignStyle>
    <UserControl.DataContext>
        <viewModels:SkillsTabViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Styles>
            <Style Selector="Button">
                <Setter Property="Margin" Value="0,7,0,0" />
            </Style>
        </Grid.Styles>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="130" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <ResourceDictionary>
                <valueConverters:LockStatusValueConverter x:Key="LockStatusValueConverter" />
                <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
                <ContextMenu x:Key="ItemContextMenu">
                    <MenuItem Header="{x:Static sharedResources:Strings.Set_Up}" Command="{Binding Source={StaticResource Proxy}, Path=Data.SetSkillLocksCommand}" CommandParameter="{x:Static data:LockStatus.Up}" />
                    <MenuItem Header="{x:Static sharedResources:Strings.Set_Down}" Command="{Binding Source={StaticResource Proxy}, Path=Data.SetSkillLocksCommand}" CommandParameter="{x:Static data:LockStatus.Down}" />
                    <MenuItem Header="{x:Static sharedResources:Strings.Set_Locked}" Command="{Binding Source={StaticResource Proxy}, Path=Data.SetSkillLocksCommand}" CommandParameter="{x:Static data:LockStatus.Locked}" />
                    <Separator />
                    <MenuItem Header="{x:Static sharedResources:Strings.Use_skill}" Command="{Binding Source={StaticResource Proxy}, Path=Data.UseSkillCommand}" />
                </ContextMenu>
            </ResourceDictionary>
        </Grid.Resources>
        <DataGrid Grid.Column="0" Margin="5" SelectedItem="{Binding SelectedItem}" ContextMenu="{StaticResource ItemContextMenu}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <Interaction.Behaviors>
                <behaviours:SkillsGridViewSortBehaviour SortChangedCommand="{Binding SortChangedCommand}" SetSortCommand="{Binding SetSortCommand, Mode=OneWayToSource}" />
            </Interaction.Behaviors>
            <DataGrid.Columns />
        </DataGrid>
        <StackPanel Grid.Column="1" Margin="10,0,10,10">
<Button Content="{x:Static sharedResources:Strings.Reset____}" Command="{Binding ResetDeltasCommand, Mode=OneWay}" />
            <TextBlock Text="{x:Static sharedResources:Strings.All_skills_}" Margin="0,20,0,0" />
            <ComboBox x:Name="comboBox" Margin="0,5,0,0" SelectedIndex="0" ItemsSource="{Binding Mode=OneWay, Source={misc1:EnumBindingSource {x:Type data:LockStatus}}}" />
            <Button Content="{x:Static sharedResources:Strings.Set}" Command="{Binding SetAllSkillLocksCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem, ElementName=comboBox}" />
            <TextBlock Text="{x:Static sharedResources:Strings.Total_base_}" Margin="0,30,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TotalBase}" FontWeight="Bold" Margin="0,3,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
