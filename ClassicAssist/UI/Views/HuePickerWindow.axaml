<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.UI.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.HuePickerWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Hue_Picker}" Height="350" Width="450" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="{x:Static resources:Strings.Filter_}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                <TextBox Text="{Binding FilterText}" />
            </DockPanel>
            <ListBox x:Name="listView" SelectedItem="{Binding SelectedItem}" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding FilteredItems}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" ToolTip.Tip="{Binding EntryName}">
                            <TextBlock Text="{Binding Index}" DockPanel.Dock="Left" Width="50" />
                            <controls:HueEntryControl HueEntry="{Binding Entry, Mode=TwoWay}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10,0,10,10" HorizontalAlignment="Right">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="10,0,0,0" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OKCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
