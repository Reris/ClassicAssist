<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:sharedControls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.HotkeysTabControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="500" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.Data.Hotkeys" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:commands="clr-namespace:ClassicAssist.Data.Hotkeys.Commands" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <!-- MIGRATION: CollectionViewSource removed - group in ViewModel instead -->
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
        <!-- MIGRATION: style for WPF-only type 'GridViewColumnHeader' removed -->
    </UserControl.Styles>
    <UserControl.DataContext>
        <viewModels:HotkeysTabViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="175" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <sharedControls:FilterControl Grid.Row="0" FilterText="{Binding FilterText}" Margin="5,10,5,0" />
            <ListBox Grid.Row="1" Margin="5" ItemsSource="{Binding Source={DynamicResource src}}" PointerWheelChanged="UIElement_OnPreviewMouseWheel">
                <!-- MIGRATION: GroupStyle removed - restructure grouping manually -->
            </ListBox>
        </Grid>
        <GroupBox Grid.Column="1" Header="{x:Static resources:Strings.Hotkeys}" Margin="0, 10, 5, 5">
            <Grid>
                <Grid.Styles>
                    <Style Selector="Button">
                        <Setter Property="Padding" Value="4" />
                    </Style>
                </Grid.Styles>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:TextBoxKey x:Name="textBoxKey" Shortcut="{Binding Hotkey}" Grid.Row="0" Margin="10">
                    <controls:TextBoxKey.Styles>
                        <Style Selector="controls|TextBoxKey">
                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=SelectedItem.IsCategory}" />
                            <Setter Property="ca:TriggerCondition.Value" Value="True" />
                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=SelectedItem.(local:HotkeyEntry.Hotkey)}" />
                            <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                            <Style Selector="^.ca-dt1">
                                <Setter Property="IsEnabled" Value="False" />
                            </Style>
                            <Style Selector="^.ca-dt2">
                                <Setter Property="IsEnabled" Value="False" />
                            </Style>
                        </Style>
                    </controls:TextBoxKey.Styles>
                </controls:TextBoxKey>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Clear}" Margin="10,0,10,5" Command="{Binding ClearHotkeyCommand}" CommandParameter="{Binding SelectedItem}" Grid.Column="0" IsEnabled="{Binding IsEnabled, ElementName=textBoxKey}" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox Content="{x:Static resources:Strings.Pass_to_UO}" Margin="10,0,10,5" IsChecked="{Binding Path=SelectedItem.(local:HotkeyEntry.PassToUO), Mode=TwoWay}" Grid.Row="0" IsEnabled="{Binding IsEnabled, ElementName=textBoxKey}" />
                    <CheckBox Content="{x:Static resources:Strings.Undisableable}" Margin="10,0,10,5" IsChecked="{Binding Path=SelectedItem.(local:HotkeyEntry.Disableable), Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" Grid.Row="1" IsEnabled="{Binding IsEnabled, ElementName=textBoxKey}" />
                    <CheckBox Content="{x:Static resources:Strings.Global}" Margin="10,0,10,5" IsChecked="{Binding Path=SelectedItem.(local:HotkeyEntry.IsGlobal)}" Grid.Row="2">
                        <CheckBox.Styles>
                            <Style Selector="CheckBox">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled, ElementName=textBoxKey}" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding SelectedItem.CanGlobal}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="False" />
                                <Style Selector="^.ca-dt3">
                                    <Setter Property="IsEnabled" Value="False" />
                                </Style>
                            </Style>
                        </CheckBox.Styles>
                    </CheckBox>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static resources:Strings.Execute}" Margin="10,0,10,5" Command="{Binding ExecuteCommand}" CommandParameter="{Binding SelectedItem}" Grid.Column="0" IsEnabled="{Binding IsEnabled, ElementName=textBoxKey}" />
                </Grid>
                <Button Grid.Row="4" Margin="10,0,10,5" Content="{x:Static resources:Strings.Create_Macro_Button}" Command="{Binding CreateMacroButtonCommand}" IsEnabled="{Binding IsEnabled, ElementName=textBoxKey}" />
                <Button Grid.Row="5" Margin="10,0,10,5" Content="{x:Static resources:Strings.Options}" IsEnabled="{Binding SelectedItem.Configurable}" Command="{Binding ConfigureHotkeyCommand}" CommandParameter="{Binding SelectedItem}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
