<Window xmlns="https://github.com/avaloniaui" xmlns:autoloot="clr-namespace:ClassicAssist.UI.ViewModels.Autoloot" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Autoloot.ClilocSelectionWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.Choose_by_Cliloc}" Height="350" Width="450" Background="{DynamicResource ThemeWindowBackgroundBrush}" Topmost="True" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <autoloot:ClilocSelectionViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Text="{Binding FilterText}" />
            <DataGrid Grid.Row="1" Margin="0,10,0,0" SelectedItem="{Binding SelectedCliloc}" ItemsSource="{Binding FilteredClilocs}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:Strings.Property}" Binding="{Binding Value}" Width="306" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Cliloc}" Binding="{Binding Key}" Width="86" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10, 0, 0">
            <Button Content="{x:Static resources:Strings.OK}" Margin="0,0,5,0" Command="{Binding OKCommand}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}" Margin="5,0,0,0">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
