<Window xmlns="https://github.com/avaloniaui" xmlns:autoloot1="clr-namespace:ClassicAssist.UI.ViewModels.Autoloot" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Autoloot.CustomPropertiesWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.Define_Custom_Properties}" Height="350" Width="725" Background="{DynamicResource ThemeWindowBackgroundBrush}" Topmost="True" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Window.DataContext>
        <autoloot1:CustomPropertiesViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="listView1" Grid.Column="0" Margin="10" SelectedItem="{Binding SelectedProperty}" ItemsSource="{Binding Properties}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resources:Strings.Property}" Binding="{Binding Name}" Width="206" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Cliloc}" Binding="{Binding Cliloc}" Width="106" />
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Arguments}" Width="81">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="autoloot1:CustomProperty">
                            <CheckBox IsChecked="{Binding Arguments}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Argument_Index}" Width="106">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="autoloot1:CustomProperty">
                            <controls:EditTextBlock Text="{Binding ArgumentIndex}" Foreground="{DynamicResource ThemeForegroundBrush}" ShowIcon="True" Width="{Binding ActualWidth, ElementName=ArgumentIndexColumn, Converter={StaticResource CellWidthValueConverter}}" IsVisible="{Binding Arguments}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Column="1">
            <Grid.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="0,10, 10, 0" />
                </Style>
            </Grid.Styles>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Content="{x:Static resources:Strings.Choose_from_Item}" Command="{Binding ChooseFromItemCommand}" />
                <Button Content="{x:Static resources:Strings.Choose_by_Cliloc}" Command="{Binding ChooseFromClilocCommand}" />
                <Button Content="{x:Static resources:Strings.Remove}" Command="{Binding RemoveCommand}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Content="{x:Static resources:Strings.Save}" Command="{Binding SaveCommand}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
                <Button Content="{x:Static resources:Strings.Cancel}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
