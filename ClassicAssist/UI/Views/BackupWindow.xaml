<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.BackupWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" WindowStartupLocation="CenterScreen" Title="{x:Static resources:Strings.Profile_Backup}" Height="500" Width="600" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Window.DataContext>
        <viewModels:BackupWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static resources:Strings.Profile_backup_in_progress___}" Margin="10" />
        <ListBox Grid.Row="1" Margin="10,0,10,10" ItemsSource="{Binding Messages}">
            <Interaction.Behaviors>
                <behaviours:ItemsControlAutoScrollBehaviour />
            </Interaction.Behaviors>
        </ListBox>
        <ProgressBar IsIndeterminate="True" Grid.Row="2" IsVisible="{Binding IsWorking}" />
    </Grid>
</Window>
