<UserControl xmlns="https://github.com/avaloniaui" xmlns:avalonedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ClassicAssist.UI.Views.Macros" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.Macros.MacrosCodeTextEditor" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:LinePausedValueConverter x:Key="LinePausedValueConverter" />
            <valueConverters:MacroExceptionValueConverter x:Key="MacroExceptionValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/Resources/LeftRightIconToggleButton.axaml" />
    </UserControl.Styles>
    <Grid Initialized="Grid_Initialized" DataContext="{Binding SelectedItem, ElementName=userControl, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <avalonedit:TextEditor ShowLineNumbers="True" x:Name="CodeTextEditor" FontFamily="Consolas">
            <avalonedit:TextEditor.Styles>
                <Style Selector="avalonedit|TextEditor">
                    <Setter Property="(Classes.NoMacro)" Value="{Binding Path=., Converter={x:Static ObjectConverters.IsNull}}" />
                    <Style Selector="^.NoMacro">
                        <Setter Property="IsEnabled" Value="False" />
                    </Style>
                </Style>
            </avalonedit:TextEditor.Styles>
            <Interaction.Behaviors>
                <behaviours:AvalonEditBehaviour TextBinding="{Binding Macro}" />
                <behaviours:AvalonBindingBehaviour DocumentBinding="{Binding Document, ElementName=userControl}" CaretBinding="{Binding CaretPosition, ElementName=userControl}" />
                <behaviours:AvalonEditBreakpointMarginBehaviour Breakpoints="{Binding Breakpoints}" />
                <behaviours:AvalonEditPausedLineBehaviour IsPaused="{Binding IsPaused}" PausedLineNumber="{Binding PausedLinedNumber}" />
                <behaviours:AvalonEditShowCompletionTooltipBehaviour IsPaused="{Binding IsPaused}" FrameVariables="{Binding FrameVariables}" />
            </Interaction.Behaviors>
        </avalonedit:TextEditor>
        <local:MacrosDebuggerControl Grid.Row="0" MacroEntry="{Binding Path=.}">
            <local:MacrosDebuggerControl.Styles>
                <Style Selector="local|MacrosDebuggerControl">
                    <Setter Property="IsVisible" Value="False" />
                    <Setter Property="(Classes.Paused)" Value="{Binding IsPaused}" />
                    <Style Selector="^.Paused">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
            </local:MacrosDebuggerControl.Styles>
        </local:MacrosDebuggerControl>
        <ProgressBar IsIndeterminate="True" Grid.Row="0" Height="5" VerticalAlignment="Bottom" IsVisible="{Binding IsPerformingAction}" />
        <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Bottom" Background="{DynamicResource ThemeBackgroundBrush}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="(Classes.NoFormatError)" Value="{Binding FormatError,ElementName=userControl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    <Style Selector="^.NoFormatError">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </StackPanel.Styles>
            <Image Source="{DynamicResource ExclamationIcon}" Height="12" Margin="10,0,10,0" />
            <TextBlock Text="{Binding FormatError, ElementName=userControl}" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="5">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="(Classes.NoException)" Value="{Binding LastException, Converter={x:Static ObjectConverters.IsNull}}" />
                    <Style Selector="^.NoException">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LastException, Converter={StaticResource MacroExceptionValueConverter}}" Grid.Column="0" />
            <Button Background="Transparent" Padding="0" Margin="0" BorderThickness="0" BorderBrush="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ClearExceptionCommand, ElementName=userControl}" CommandParameter="{Binding Path=.}" Height="12" Grid.Column="1">
                <Image Source="{DynamicResource closeIcon}" Margin="0,0,0,0" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" Margin="5">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="IsVisible" Value="False" />
                    <Setter Property="(Classes.Paused)" Value="{Binding IsPaused}" />
                    <Style Selector="^.Paused">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PausedLinedNumber, Converter={StaticResource LinePausedValueConverter}}" Grid.Column="0" />
        </Grid>
    </Grid>
</UserControl>
