<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:macros="clr-namespace:ClassicAssist.UI.ViewModels.Macros" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Macros.MacrosCommandWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Commands}" Height="350" Width="400" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <!-- MIGRATION: CollectionViewSource removed - group in ViewModel instead -->
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <macros:MacrosCommandViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <ListBox ItemsSource="{Binding Source={DynamicResource src}}">
                <!-- MIGRATION: GroupStyle removed - restructure grouping manually -->
            </ListBox>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Margin" Value="0,0,10,0" />
                    </Style>
                </StackPanel.Styles>
                <Button Content="{x:Static resources:Strings.Close}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
                <Button Content="{x:Static resources:Strings.Insert}" Command="{Binding InsertCommand}" CommandParameter="{Binding SelectedItem}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
