<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:headered="clr-namespace:ClassicAssist.Controls.Headered;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sharedControls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugPacketsControl" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.UI.Views.Debug" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:packetFilter="clr-namespace:ClassicAssist.UO.Network.PacketFilter" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.xaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugPacketsViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <sharedControls:ImageButton Command="{Binding ClearCommand}" ImageSource="{DynamicResource RemoveIcon}" ToolTip.Tip="{x:Static resources:Strings.Clear_All}" />
            <sharedControls:ImageButton Command="{Binding ViewPlayerEquipmentCommand}" ImageSource="{DynamicResource PersonIcon}" ToolTip.Tip="View Player Equipment" />
            <sharedControls:ImageButton Command="{Binding ExportLogCommand}" CommandParameter="{Binding Items}" Margin="0,0,5,0" ImageSource="{DynamicResource ExportIcon}" ToolTip.Tip="{x:Static resources:Strings.Save}" />
            <ComboBox Width="100" BorderThickness="1" Background="{DynamicResource ThemeBackgroundBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" ItemsSource="{Binding PacketEntries}">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid x:Name="ToggleGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static resources:Strings.Enabled_Packets}" Grid.Column="0" />
                                <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" Command="{Binding DataContext.ChangePacketEnabledCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DebugPacketsControl}}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <headered:HorizontalHeaderedContentControl Header="{x:Static resources:Strings.Direction}" Margin="10,0,0,0">
                <ComboBox SelectedItem="{Binding Direction}" MinWidth="100" Margin="5,0,0,0" ItemsSource="{Binding Source={misc:EnumBindingSource {x:Type packetFilter:PacketDirection}}}" />
            </headered:HorizontalHeaderedContentControl>
            <CheckBox Margin="10,0,0,0" Content="{x:Static resources:Strings.Include_Internal}" IsChecked="{Binding IncludeInternal}" Foreground="{DynamicResource ThemeForegroundBrush}" />
            <sharedControls:ImageButton ImageSource="{DynamicResource RefreshIcon}" Margin="10,0,0,0" Command="{Binding ResetCommand}" ToolTip.Tip="{x:Static resources:Strings.Reset}" />
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}" Grid.Row="1">
            <ListBox ItemsSource="{Binding Items}">
                <Interaction.Behaviors>
                    <behaviours:ItemsControlAutoScrollBehaviour />
                </Interaction.Behaviors>
                <ListBox.Template>
                    <ControlTemplate>
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Background="{DynamicResource ThemeInnerControlBackgroundBrush}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:HexDumpControl Packet="{Binding}" PacketEntries="{Binding DataContext.PacketEntries, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DebugPacketsControl}}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
            <CheckBox Content="{x:Static resources:Strings.Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Enabled}" />
        </StackPanel>
    </Grid>
</UserControl>
