<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugPropertiesControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" d:DesignHeight="450" d:DesignWidth="800" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:misc="clr-namespace:ClassicAssist.UI.Misc" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <debug:JoinArrayValueConverter x:Key="JoinArrayValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugPropertiesViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <controls:ImageButton Command="{Binding TargetCommand}" ImageSource="{DynamicResource CrosshairIcon}" ToolTip.Tip="{x:Static resources:Strings.Target_object___}" />
        </StackPanel>
        <DataGrid Grid.Row="1" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <Interaction.Behaviors>
                <behaviours:ClipboardBehaviour CopyCommand="{Binding ClipboardCopyCommand}" />
            </Interaction.Behaviors>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resources:Strings.Cliloc}" Binding="{Binding Cliloc}" Width="81" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Text}" Width="256" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Arguments}" Binding="{Binding Arguments, Converter={StaticResource JoinArrayValueConverter}}" Width="181" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
