<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugSpecialMovesControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" d:DesignHeight="400" d:DesignWidth="550" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugSpecialMovesViewModel />
    </UserControl.DataContext>
    <controls:TwoColumnSplitterControl>
        <controls:TwoColumnSplitterControl.LeftContent>
            <ListBox MinWidth="120" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" />
        </controls:TwoColumnSplitterControl.LeftContent>
        <controls:TwoColumnSplitterControl.RightContent>
            <ListBox ItemsSource="{Binding Messages}" />
        </controls:TwoColumnSplitterControl.RightContent>
    </controls:TwoColumnSplitterControl>
</UserControl>
