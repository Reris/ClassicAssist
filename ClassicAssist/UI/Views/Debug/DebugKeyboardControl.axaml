<UserControl xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugKeyboardControl" Background="{DynamicResource ThemeBackgroundBrush}" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance d:Type=debug:DebugKeyboardViewModel}" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.xaml" />
    </UserControl.Styles>
    <Grid>
        <Grid.Styles>
            <Style Selector="Label">
                <Setter Property="Margin" Value="0,0,5,0" />
            </Style>
        </Grid.Styles>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label Content="Keyboard Name:" />
            <Label Content="{Binding KeyboardName}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Keyboard Layout Id:" />
            <Label Content="{Binding KeyboardLayoutId}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Content="Test Key" Margin="0,5,5,5" Command="{Binding TestKeyCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Grid.Row="3" />
        <DataGrid x:Name="listView1" Grid.Row="4" Margin="0,10,0,10" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding FailKeys}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemoveItemCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedItem}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="UO Key" Binding="{Binding UOKeyString}" Width="206" />
                <DataGridTextColumn Header="WPF Key" Binding="{Binding WPFKeyString}" Width="206" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="5" Content="{x:Static resources:Strings.Save}" HorizontalAlignment="Right" Command="{Binding SaveCommand}" />
    </Grid>
</UserControl>
