<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugActionQueueControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" d:DesignHeight="400" d:DesignWidth="550" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugActionQueueViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <controls:ImageButton Command="{Binding ClearCommand}" ImageSource="{DynamicResource RemoveIcon}" ToolTip.Tip="{x:Static resources:Strings.Clear}" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="ListBox" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <Interaction.Behaviors>
                <behaviours:ItemsControlAutoScrollBehaviour />
            </Interaction.Behaviors>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static resources:Strings.ID}" Binding="{Binding ID}" Width="246" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Event}" Binding="{Binding Event}" Width="71" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Caller}" Binding="{Binding Caller}" Width="96" />
                <DataGridTextColumn Header="{x:Static resources:Strings.Elapsed}" Binding="{Binding Elapsed}" Width="116" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0, 10, 0, 0">
            <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding Enabled}" />
        </StackPanel>
    </Grid>
</UserControl>
