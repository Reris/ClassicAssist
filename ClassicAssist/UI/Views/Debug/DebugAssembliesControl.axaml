<UserControl xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugAssembliesControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" d:DesignHeight="250" d:DesignWidth="300" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:reflection="clr-namespace:System.Reflection;assembly=mscorlib" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugAssembliesViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <TextBlock Text="{x:Static resources:Strings.Additional_assemblies_to_load_}" DockPanel.Dock="Top" />
            <DataGrid x:Name="listView" Margin="0,10,0,10" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Name}" Width="{Binding ActualWidth, ElementName=listView, Mode=OneWay, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=20}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="reflection:Assembly">
                                <TextBlock Text="{Binding}" ToolTip.Tip="{Binding Location, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.Load}" Command="{Binding LoadCommand}" />
            <Button Content="{x:Static resources:Strings.Remove}" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}" />
            <Button Content="{x:Static resources:Strings.Save}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
