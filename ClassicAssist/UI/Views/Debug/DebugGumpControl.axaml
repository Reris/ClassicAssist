<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugGumpControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" d:DesignHeight="400" d:DesignWidth="550" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.xaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugGumpViewModel />
    </UserControl.DataContext>
    <controls:TwoColumnSplitterControl>
        <controls:TwoColumnSplitterControl.LeftContent>
            <ListBox MinWidth="120" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ID, StringFormat={}0x{0:x8}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:TwoColumnSplitterControl.LeftContent>
        <controls:TwoColumnSplitterControl.RightContent>
            <TextBox Text="{Binding Text}" ScrollViewer.VerticalScrollBarVisibility="Auto" Classes="TextBoxStyle" />
        </controls:TwoColumnSplitterControl.RightContent>
    </controls:TwoColumnSplitterControl>
</UserControl>
