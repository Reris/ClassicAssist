<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:debug="clr-namespace:ClassicAssist.UI.ViewModels.Debug" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Debug.DebugPacketQueueControl" mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="550" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <debug:DebugPacketQueueViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <controls:ImageButton Command="{Binding ClearCommand}" ImageSource="{DynamicResource RemoveIcon}" ToolTip.Tip="{x:Static resources:Strings.Clear_All}" />
            <TextBlock Text="Threshold:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Threshold}" Width="100" />
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}" Grid.Row="1">
            <ListBox ItemsSource="{Binding Items}">
                <Interaction.Behaviors>
                    <behaviours:ItemsControlAutoScrollBehaviour />
                </Interaction.Behaviors>
                <ListBox.Template>
                    <ControlTemplate>
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Background="{DynamicResource ThemeInnerControlBackgroundBrush}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding IncomingQueueLength, StringFormat={}Incoming queue length: {0}}" />
            <TextBlock Text="{Binding OutgoingQueueLength, StringFormat={}Outgoing queue length: {0}}" />
        </StackPanel>
    </Grid>
</UserControl>
