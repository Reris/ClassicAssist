<Styles xmlns="https://github.com/avaloniaui" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.ToolbarButtonStyle">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Opacity" Value="1" />
        <Style Selector="Button.ToolbarButtonStyle:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Style>
    <Style Selector="ToggleButton.ToolbarToggleButtonStyle">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Opacity" Value="1" />
        <Style Selector="ToggleButton.ToolbarToggleButtonStyle:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Style>
</Styles>
