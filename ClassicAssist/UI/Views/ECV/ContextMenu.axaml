<Styles xmlns="https://github.com/avaloniaui" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels">
    <Styles.Resources>
        <ResourceDictionary>
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <ContextMenu x:Key="ContextMenu">
        <MenuItem Header="{x:Static resources:Strings.Use_item}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextUseItemCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Move_to_backpack}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextMoveToBackpackCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Move_to_container}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextMoveToContainerCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Move_to_bank}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextMoveToBankCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Move_to_ground}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextMoveToGroundCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Move_to_set}" ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).Options.ContainerSets}">
            <MenuItem.Styles>
                <Style Selector="MenuItem">
                    <Setter Property="(Classes.NoContainerSets)" Value="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).Options.ContainerSets.Count, Converter={x:Static valueConverters:ValueEqualityConverter.Instance}, ConverterParameter=0}" />
                    <Style Selector="^.NoContainerSets">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </MenuItem.Styles>
<!-- MIGRATION: MenuItem.ItemContainerStyle removed - no Avalonia equivalent -->
            </MenuItem>
        <MenuItem Header="{x:Static resources:Strings.Open_container}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextOpenContainerCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Drop_to_ground}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextDropToGroundCommand}" />
        <Separator />
        <MenuItem Header="{x:Static resources:Strings.Lock_item}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextToggleLockCommand}">
            <MenuItem.Styles>
                <Style Selector="MenuItem">
                    <Setter Property="(Classes.AllLocked)" Value="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).SelectedItemsAllLocked}" />
                    <Style Selector="^.AllLocked">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="{x:Static resources:Strings.Unlock_item}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextToggleLockCommand}">
            <MenuItem.Styles>
                <Style Selector="MenuItem">
                    <Setter Property="(Classes.NotAllLocked)" Value="{Binding Source={StaticResource Proxy}, Path=!Data.(viewModels:EntityCollectionViewerViewModel).SelectedItemsAllLocked}" />
                    <Style Selector="^.NotAllLocked">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static resources:Strings.Context_menu_request}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextContextMenuRequestCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Equip_Item}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).EquipItemCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Hide}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).HideItemCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Custom_Actions}" ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).CustomContextActions}">
            <MenuItem.Styles>
                <Style Selector="MenuItem">
                    <Setter Property="(Classes.NoCustomActions)" Value="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).CustomContextActions.Count, Converter={x:Static valueConverters:ValueEqualityConverter.Instance}, ConverterParameter=0}" />
                    <Style Selector="^.NoCustomActions">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </Style>
            </MenuItem.Styles>
<!-- MIGRATION: MenuItem.ItemContainerStyle removed - no Avalonia equivalent -->
            </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static resources:Strings.Target}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextTargetCommand}" />
        <MenuItem Header="{x:Static resources:Strings.Target_Owner}" Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ContextTargetOwnerCommand}" />
    </ContextMenu>
        </ResourceDictionary>
    </Styles.Resources>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/MenuStyles.axaml" />
    
    
</Styles>
