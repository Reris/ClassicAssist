<Styles xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels">
    <Styles.Resources>
        <ResourceDictionary>
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <ItemsPanelTemplate x:Key="ItemsPanelTemplate">
        <VirtualizingStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
            <DataTemplate x:Key="DataTemplate">
        <DockPanel x:Name="DockPanel" Background="Transparent" ca:TriggerCondition.Bind="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ShowProperties}" ca:TriggerCondition.Value="True" ca:TriggerCondition.Key="dt4">
            <Interaction.Behaviors>
                <behaviours:DoubleClickBehaviour Command="{Binding Source={StaticResource Proxy}, Path=Data.(viewModels:EntityCollectionViewerViewModel).ItemDoubleClickCommand}" CommandParameter="{Binding $parent[ListBox].SelectedItem}" />
            </Interaction.Behaviors>
            <StackPanel ContextMenu="{DynamicResource ContextMenu}">
                <Grid DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Image Source="{Binding Bitmap}" Height="32" Stretch="Uniform" HorizontalAlignment="Center" />
                    <Image x:Name="LockIcon" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="{x:Static viewModels:EntityCollectionViewerViewModel.PadlockIcon}" IsVisible="False" />
                </Grid>
                <Border x:Name="Border" BorderThickness="1">
                    <TextBlock x:Name="TextBlock" Text="{Binding Name}" TextAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" DockPanel.Dock="Bottom" Padding="1" TextWrapping="WrapWithOverflow" ToolTip.Tip="{Binding FullName}" />
                </Border>
            </StackPanel>
        </DockPanel>
    </DataTemplate>
        </ResourceDictionary>
    </Styles.Resources>
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/ContextMenu.axaml" />
    
    
    
    <Style Selector="ListBoxItem.FileItemStyle">
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="ListBox.EntityListViewStyle">
        <Setter Property="ItemsPanel" Value="{StaticResource ItemsPanelTemplate}" />
        <Setter Property="ItemTemplate" Value="{StaticResource DataTemplate}" />
    </Style>
    <Style Selector="DockPanel.ca-dt1">
        <Style Selector="^ Image#LockIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Style>
    <Style Selector="DockPanel.ca-dt2">
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="Background" Value="{DynamicResource SelectionColor1Brush}" />
        </Style>
        <Style Selector="^ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionColor2Brush}" />
        </Style>
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
    </Style>
    <Style Selector="DockPanel.ca-dt3">
        <Setter Property="Width" Value="60" />
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="Text" Value="{Binding Name}" />
        </Style>
    </Style>
    <Style Selector="DockPanel.ca-dt4">
        <Setter Property="Width" Value="120" />
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="^ TextBlock#TextBlock">
            <Setter Property="Text" Value="{Binding FullName}" />
        </Style>
    </Style>
</Styles>
