<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ClassicAssist.UI.Views.ECV.Settings" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Models" xmlns:settingsControls="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.ECV.Settings.OpenContainersSettingsControl" mc:Ignorable="d" Background="Transparent" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:OpenContainersSettingsViewModel x:Key="DummyData">
                <local:OpenContainersSettingsViewModel.Items>
                    <models:CombineStacksOpenContainersIgnoreEntry />
                    <models:CombineStacksOpenContainersIgnoreEntry />
                    <models:CombineStacksOpenContainersIgnoreEntry Hue="-1" />
                </local:OpenContainersSettingsViewModel.Items>
            </local:OpenContainersSettingsViewModel>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.xaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <local:OpenContainersSettingsViewModel />
    </UserControl.DataContext>
    <GroupBox Header="{x:Static resources:Strings.Ignore_List}" Padding="5" d:DataContext="{StaticResource DummyData}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,5" Classes="ToolBarStyle1">
                <StackPanel.Styles>
                    <Style Selector="controls|ImageButton">
                        <Setter Property="Margin" Value="0,0,5,0" />
                    </Style>
                </StackPanel.Styles>
                <controls:ImageButton ImageSource="{DynamicResource PlusIcon}" Command="{Binding AddEntryCommand}" />
                <controls:ImageButton ImageSource="{DynamicResource RemoveIcon}" Command="{Binding RemoveEntryCommand}" CommandParameter="{Binding SelectedItem}" />
            </StackPanel>
            <settingsControls:IgnoreSettingsControl Grid.Row="2" />
        </Grid>
    </GroupBox>
</UserControl>
