<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks.HueEditTextBlock" mc:Ignorable="d" d:DesignWidth="400">
    <controls:EditTextBlock ShowIcon="True" Label="{Binding Label, ElementName=userControl}" Text="{Binding Hue, ElementName=userControl}" />
</UserControl>
