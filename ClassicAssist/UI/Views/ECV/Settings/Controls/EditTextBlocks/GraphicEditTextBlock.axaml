<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:settingsValueConverters="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.ValueConverters" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks.GraphicEditTextBlock" mc:Ignorable="d" d:DesignWidth="400" xmlns:editTextBlocks="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <settingsValueConverters:GraphicValueConverter x:Key="GraphicValueConverter" />
            <valueConverters:IntToHexStringValueConverter x:Key="IntToHexStringValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <controls:EditTextBlock Text="{Binding ID, ElementName=userControl, Converter={StaticResource IntToHexStringValueConverter}}" ShowIcon="True" CanEdit="True" ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}">
        <controls:EditTextBlock.Label>
            <MultiBinding StringFormat="{}{0} {1}">
                <Binding Path="Label" ElementName="userControl" />
                <Binding Path="ID" ElementName="userControl" Converter="{StaticResource GraphicValueConverter}" />
            </MultiBinding>
        </controls:EditTextBlock.Label>
        <controls:EditTextBlock.Buttons>
            <StackPanel Orientation="Horizontal">
                <controls:ImageButton ImageSource="{DynamicResource CrosshairIcon}" BorderThickness="0" HorizontalAlignment="Right" Padding="0" Margin="2,0,0,0" Command="{Binding TargetCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type editTextBlocks:GraphicEditTextBlock}}}" />
            </StackPanel>
        </controls:EditTextBlock.Buttons>
    </controls:EditTextBlock>
</UserControl>
