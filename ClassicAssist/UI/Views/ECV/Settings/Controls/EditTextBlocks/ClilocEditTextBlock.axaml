<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks.ClilocEditTextBlock" mc:Ignorable="d" d:DesignWidth="300" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:editTextBlocks="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </UserControl.Styles>
    <controls:EditTextBlock Text="{Binding Cliloc, ElementName=userControl}" Label="{Binding Label, ElementName=userControl}" ShowIcon="True" CanEdit="True">
        <controls:EditTextBlock.Buttons>
            <StackPanel Orientation="Horizontal">
                <controls:ImageButton ImageSource="{DynamicResource ExportIcon}" BorderThickness="0" HorizontalAlignment="Right" Padding="0" Margin="2,0,0,0" Command="{Binding ChooseClilocCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type editTextBlocks:ClilocEditTextBlock}}}" CommandParameter="{Binding Cliloc, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type editTextBlocks:ClilocEditTextBlock}}}" ToolTip.Tip="{x:Static resources:Strings.Choose_by_Cliloc}" />
                <controls:ImageButton ImageSource="{DynamicResource CrosshairIcon}" BorderThickness="0" HorizontalAlignment="Right" Padding="0" Margin="2,0,0,0" Command="{Binding TargetCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type editTextBlocks:ClilocEditTextBlock}}}" />
            </StackPanel>
        </controls:EditTextBlock.Buttons>
    </controls:EditTextBlock>
</UserControl>
