<UserControl xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:editTextBlocks="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Controls.EditTextBlocks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Misc" xmlns:misc1="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.ECV.Settings.Controls.IgnoreSettingsControl" mc:Ignorable="d" d:DesignWidth="800" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:models="clr-namespace:ClassicAssist.UI.Views.ECV.Settings.Models" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <misc1:BindingProxy x:Key="ClilocEditTextBlockProxy" />
            <misc1:BindingProxy x:Key="HueEditTextBlockProxy" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.xaml" />
    </UserControl.Styles>
    <DataGrid SelectedItem="{Binding SelectedItem}" MinHeight="150" MaxHeight="200" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.ID}" Width="186">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="models:CombineStacksOpenContainersIgnoreEntry">
                        <editTextBlocks:GraphicEditTextBlock ID="{Binding ID}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, Mode=OneWay, ElementName=IDColumn}" ClilocEditTextBlock="{Binding Source={StaticResource ClilocEditTextBlockProxy}, Path=Data}" HueEditTextBlock="{Binding Source={StaticResource HueEditTextBlockProxy}, Path=Data}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Cliloc}" Width="256">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="models:CombineStacksOpenContainersIgnoreEntry">
                        <editTextBlocks:ClilocEditTextBlock Cliloc="{Binding Cliloc}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, Mode=OneWay, ElementName=ClilocColumn}">
                            <Interaction.Behaviors>
                                <misc:SetBindingProxyBehaviour Proxy="{StaticResource ClilocEditTextBlockProxy}" />
                            </Interaction.Behaviors>
                        </editTextBlocks:ClilocEditTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="106">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="models:CombineStacksOpenContainersIgnoreEntry">
                        <editTextBlocks:HueEditTextBlock Hue="{Binding Hue}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, Mode=OneWay, ElementName=HueColumn}">
                            <Interaction.Behaviors>
                                <misc:SetBindingProxyBehaviour Proxy="{StaticResource HueEditTextBlockProxy}" />
                            </Interaction.Behaviors>
                        </editTextBlocks:HueEditTextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
