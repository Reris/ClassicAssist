<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.Controls.Misc.Behaviours;assembly=ClassicAssist.Controls" xmlns:behaviours1="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:draggableTreeView="clr-namespace:ClassicAssist.Controls.DraggableTreeView;assembly=ClassicAssist.Controls" xmlns:ecv="clr-namespace:ClassicAssist.UI.Views.ECV" xmlns:filter="clr-namespace:ClassicAssist.UI.Views.ECV.Filter" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:localValueConverters="clr-namespace:ClassicAssist.UI.Views.ECV.Filter.ValueConverters" xmlns:valueConverters1="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:views="clr-namespace:ClassicAssist.UI.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.ECV.Filter.EntityCollectionFilterControl" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:agents="clr-namespace:ClassicAssist.UI.ViewModels.Agents" xmlns:misc1="clr-namespace:ClassicAssist.UI.Misc" xmlns:autoloot="clr-namespace:ClassicAssist.Data.Autoloot" xmlns:data="clr-namespace:ClassicAssist.UO.Data" xmlns:models="clr-namespace:ClassicAssist.UI.Views.ECV.Filter.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <valueConverters:HexToIntValueConverter x:Key="HexToIntValueConverter" />
            <valueConverters:AutolootOperatorFilterValueConverter x:Key="AutolootOperatorFilterValueConverter" />
            <valueConverters1:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <valueConverters1:EnumToIntegerValueConverter x:Key="EnumToIntegerValueConverter" />
            <localValueConverters:GroupItemMultiValueConverter x:Key="GroupItemMultiValueConverter" />
            <misc:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
            <TreeDataTemplate x:Key="FilterGroupTreeTemplate" ItemsSource="{Binding Children}" DataType="models:EntityCollectionFilterGroup">
                <StackPanel Orientation="Horizontal" Margin="2">
                    <ComboBox SelectedItem="{Binding Operation}" MinWidth="60" Margin="0,0,5,0" ItemsSource="{Binding Mode=OneWay, Source={misc1:EnumBindingSource {x:Type models:BooleanOperation}}}">
                        <ComboBox.Styles>
                            <Style Selector="ComboBox">
                                <Setter Property="IsVisible" Value="True" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsFirst}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                <Style Selector="^.ca-dt1">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" />
                </StackPanel>
            </TreeDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataTemplates>
            <DataTemplate DataType="models:EntityCollectionFilterGroup">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" x:Name="OperationPanel">
                        <ComboBox MinWidth="100" SelectedItem="{Binding Operation}" Margin="0,0,5,0" ItemsSource="{Binding Mode=OneWay, Source={misc1:EnumBindingSource {x:Type models:BooleanOperation}}}">
                            <ComboBox.Styles>
                                <Style Selector="ComboBox">
                                    <Setter Property="IsVisible" Value="True" />
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsFirst}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                    <Style Selector="^.ca-dt2">
                                        <Setter Property="IsVisible" Value="False" />
                                    </Style>
                                </Style>
                            </ComboBox.Styles>
                        </ComboBox>
                        <controls:ImageButton ImageSource="{DynamicResource CirclePlusItem}" Command="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.AddSubGroupCommand), Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}" Margin="5,0,0,0" ToolTip.Tip="{x:Static resources:Strings.New_Group}">
                            <controls:ImageButton.Styles>
                                <Style Selector="controls|ImageButton">
                                    <Setter Property="IsVisible" Value="False" />
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasChildren}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                    <Style Selector="^.ca-dt3">
                                        <Setter Property="IsVisible" Value="True" />
                                    </Style>
                                </Style>
                            </controls:ImageButton.Styles>
                        </controls:ImageButton>
                        <controls:ImageButton ImageSource="{DynamicResource CircleRemoveIcon}" Command="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.RemoveSubGroupCommand), Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}" Margin="5,0,0,0" ToolTip.Tip="{x:Static resources:Strings.Remove_Group}">
                            <controls:ImageButton.Styles>
                                <Style Selector="controls|ImageButton">
                                    <Setter Property="IsVisible" Value="False" />
                                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasChildren}" />
                                    <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                    <Style Selector="^.ca-dt4">
                                        <Setter Property="IsVisible" Value="True" />
                                    </Style>
                                </Style>
                            </controls:ImageButton.Styles>
                        </controls:ImageButton>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="0,5" FontStyle="Italic" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" Text="{x:Static resources:Strings.Filter_Group_BranchPlaceholder}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="IsVisible" Value="False" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasChildren}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                <Style Selector="^.ca-dt5">
                                    <Setter Property="IsVisible" Value="True" />
                                </Style>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <DataGrid x:Name="listView" Margin="0,5" MinHeight="50" Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Styles>
                            <Style Selector="DataGrid">
                                <Setter Property="IsVisible" Value="True" />
                                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasChildren}" />
                                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                <Style Selector="^.ca-dt22">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:EntityCollectionFilterItem">
                                        <CheckBox IsChecked="{Binding Enabled}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Property}" Width="226">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:EntityCollectionFilterItem">
                                        <StackPanel>
                                            <ComboBox SelectedItem="{Binding Constraint}" Width="200" DisplayMemberBinding="{Binding Name}" ItemsSource="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.Constraints), Source={StaticResource DataContextProxy}}" />
                                            <ecv:SkillBonusSelector Margin="0,5,0,0" DataContext="{Binding}">
                                                <ecv:SkillBonusSelector.Styles>
                                                    <Style Selector="ecv|SkillBonusSelector">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Type agents:SkillBonusSkills}" />
                                                        <Style Selector="^.ca-dt6">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </ecv:SkillBonusSelector.Styles>
                                            </ecv:SkillBonusSelector>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Operator}" Width="81">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:EntityCollectionFilterItem">
                                        <ComboBox Width="50" SelectedItem="{Binding Operator}">
                                            <ComboBox.ItemsSource>
                                                <MultiBinding Converter="{StaticResource AutolootOperatorFilterValueConverter}">
                                                    <Binding Source="{x:Type autoloot:AutolootOperator}" />
                                                    <Binding Path="Constraint" />
                                                </MultiBinding>
                                            </ComboBox.ItemsSource>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static resources:Strings.Value}" Width="166">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:EntityCollectionFilterItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Width="90" SelectedItem="{Binding Value, Converter={StaticResource EnumToIntegerValueConverter}, ConverterParameter={x:Type data:Layer}}" ItemsSource="{Binding Source={misc1:EnumBindingSource {x:Type data:Layer}}}">
                                                <ComboBox.Styles>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Type data:Layer}" />
                                                        <Style Selector="^.ca-dt7">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </ComboBox.Styles>
                                            </ComboBox>
                                            <ComboBox Grid.Column="0" Width="90" SelectedItem="{Binding Value, Converter={StaticResource EnumToIntegerValueConverter}, ConverterParameter={x:Type data:TileFlags}}" ItemsSource="{Binding Source={misc1:EnumBindingSource {x:Type data:TileFlags}}}">
                                                <ComboBox.Styles>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Type data:TileFlags}" />
                                                        <Style Selector="^.ca-dt8">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </ComboBox.Styles>
                                            </ComboBox>
                                            <views:MultiItemIDSelector Grid.Column="0" Values="{Binding Values, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}">
                                                <views:MultiItemIDSelector.Styles>
                                                    <Style Selector="views|MultiItemIDSelector">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.UseMultipleValues}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Cliloc__Multiple_}" />
                                                        <Style Selector="^.ca-dt9">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt10">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                    </Style>
                                                </views:MultiItemIDSelector.Styles>
                                            </views:MultiItemIDSelector>
                                            <views:MultiClilocSelector Grid.Column="0" Values="{Binding Values, Mode=TwoWay}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}">
                                                <views:MultiClilocSelector.Styles>
                                                    <Style Selector="views|MultiClilocSelector">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Cliloc__Multiple_}" />
                                                        <Style Selector="^.ca-dt11">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </views:MultiClilocSelector.Styles>
                                            </views:MultiClilocSelector>
                                            <ComboBox Grid.Column="0" MinWidth="40" SelectedItem="{Binding Additional}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}" ItemsSource="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.AutolootEntryNames), Source={StaticResource DataContextProxy}}">
                                                <ComboBox.Styles>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Autoloot_Match}" />
                                                        <Style Selector="^.ca-dt12">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </ComboBox.Styles>
                                            </ComboBox>
                                            <ComboBox Grid.Column="0" MinWidth="40" SelectedItem="{Binding Additional}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}" ItemsSource="{Binding Constraint.Options}">
                                                <ComboBox.Styles>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="IsVisible" Value="True" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Options}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                                        <Style Selector="^.ca-dt13">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                    </Style>
                                                </ComboBox.Styles>
                                            </ComboBox>
                                            <TextBox Text="{Binding Value, Mode=TwoWay, Converter={StaticResource HexToIntValueConverter}}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}" MinWidth="40" Grid.Column="0">
                                                <TextBox.Styles>
                                                    <Style Selector="TextBox">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Type agents:SkillBonusSkills}" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.AllowedValuesEnum}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Type data:TileFlags}" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.UseMultipleValues}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Autoloot_Match}" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Options, Converter={StaticResource NullToBooleanConverter}}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                                                        <Style Selector="^.ca-dt14">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt15">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt16">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt17">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt18">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt19">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                        <Style Selector="^.ca-dt20">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                    </Style>
                                                </TextBox.Styles>
                                            </TextBox>
                                            <TextBox Text="{Binding Additional}" Width="{Binding ActualWidth, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15, ElementName=GridViewColumn, Mode=OneWay}">
                                                <TextBox.Styles>
                                                    <Style Selector="TextBox">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Constraint.Name}" />
                                                        <Setter Property="ca:TriggerCondition.Value" Value="{x:Static resources:Strings.Name}" />
                                                        <Style Selector="^.ca-dt21">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </Style>
                                                    </Style>
                                                </TextBox.Styles>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Padding" Value="5" />
                                                </Style>
                                            </StackPanel.Styles>
                                            <Button Command="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.AddCommand), Source={StaticResource DataContextProxy}}" CommandParameter="{Binding Path=ItemsSource, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}">
                                                <Image Source="{DynamicResource PlusIcon}" Height="8" />
                                            </Button>
                                            <Button Command="{Binding Path=Data.(filter:EntityCollectionFilterViewModel.RemoveCommand), Source={StaticResource DataContextProxy}}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource GroupItemMultiValueConverter}">
                                                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ListBox}}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Image Source="{DynamicResource MinusIcon}" Height="8" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DataTemplate>
    </UserControl.DataTemplates>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/Filter/Styles.axaml" />
    </UserControl.Styles>
    <UserControl.DataContext>
        <filter:EntityCollectionFilterViewModel />
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
        <ScrollViewer.KeyBindings>
            <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProfilesCommand}" />
        </ScrollViewer.KeyBindings>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <controls:ImageButton ImageSource="{DynamicResource AddIcon}" Margin="0,0,5,0" Command="{Binding AddProfileCommand}" ToolTip.Tip="{x:Static resources:Strings.Add}" />
                <controls:ImageButton ImageSource="{DynamicResource RemoveIcon}" Margin="0,0,5,0" Command="{Binding RemoveProfileCommand}" ToolTip.Tip="{x:Static resources:Strings.Remove}" />
                <ComboBox Width="200" IsEditable="True" SelectedItem="{Binding SelectedProfile}" ItemsSource="{Binding Profiles}" Classes="EditComboBox">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Stretch" Grid.Column="0" />
                                <controls:ImageButton ImageSource="{DynamicResource ClearIcon}" Grid.Column="1" Command="{Binding ElementName=userControl, Path=DataContext.RemoveProfileCommand}" CommandParameter="{Binding}">
                                    <Interaction.Behaviors>
                                        <behaviours:ImageButtonConfirmDeleteBehaviour />
                                    </Interaction.Behaviors>
                                </controls:ImageButton>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <Interaction.Behaviors>
                        <behaviours1:ComboBoxBehavior CommandBinding="{Binding ChangeProfileCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}" OnlyUserTriggered="True" />
                    </Interaction.Behaviors>
                </ComboBox>
            </StackPanel>
            <ItemsControl Grid.Row="1" Margin="0,5" ItemsSource="{Binding Item.Groups}">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasSubgroups}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt23">
                            <Setter Property="IsVisible" Value="True" />
                        </Style>
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>
            <Grid Grid.Row="1" Margin="0,5">
                <Grid.Styles>
                    <Style Selector="Grid">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding HasSubgroups}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="True" />
                        <Style Selector="^.ca-dt24">
                            <Setter Property="IsVisible" Value="True" />
                        </Style>
                    </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <draggableTreeView:DraggableTreeView Grid.Column="0" ItemTemplate="{StaticResource FilterGroupTreeTemplate}" BindableSelectedGroup="{Binding SelectedGroup, Mode=TwoWay}" AllowDragGroups="True" AllowDragItemsOntoItems="False" Background="{DynamicResource ThemeInnerControlBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ItemsSource="{Binding Item.Groups}">
                    <draggableTreeView:DraggableTreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </draggableTreeView:DraggableTreeView.Styles>
                </draggableTreeView:DraggableTreeView>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeBorderBrush}" />
                <ContentPresenter Content="{Binding SelectedGroup}" Grid.Column="2" Margin="5,0,0,0" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="10,0">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Margin" Value="10,0,0,0" />
                    </Style>
                </StackPanel.Styles>
                <Button Content="{x:Static resources:Strings.Apply}" Command="{Binding ApplyCommand}" />
                <Button Content="{x:Static resources:Strings.Reset}" Command="{Binding ResetCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
