<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="window" x:Class="ClassicAssist.UI.Views.Hotkeys.HotkeyOptionsWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.Options}" SizeToContent="Height" Width="300" Background="{DynamicResource ThemeWindowBackgroundBrush}" Topmost="True" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="ContentGrid" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="5,0,0,0" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OkCommand, ElementName=window, Mode=OneWay}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
