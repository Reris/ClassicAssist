<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc1="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.ActiveObjectsWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Active_Objects}" Height="350" Width="400" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:IntToHexStringValueConverter x:Key="IntToHexStringValueConverter" />
            <misc1:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <viewModels:ActiveObjectsViewModel x:Key="DummyData">
                <viewModels:ActiveObjectsViewModel.Aliases>
                    <viewModels:AliasEntry Name="Fake" Serial="666" />
                </viewModels:ActiveObjectsViewModel.Aliases>
                <viewModels:ActiveObjectsViewModel.InstanceAliases>
                    <viewModels:InstanceAliasEntry Name="Fake" Serial="666" />
                </viewModels:ActiveObjectsViewModel.InstanceAliases>
            </viewModels:ActiveObjectsViewModel>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Window.DataContext>
        <viewModels:ActiveObjectsViewModel />
    </Window.DataContext>
    <Grid Margin="10" d:DataContext="{StaticResource DummyData}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="{x:Static resources:Strings.Aliases}">
                <TabControl>
                    <TabItem Header="{x:Static resources:Strings.Global}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid SelectedItem="{Binding SelectedAlias}" ItemsSource="{Binding Aliases}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemoveAliasCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedAlias}" />
                                        <MenuItem Header="{x:Static resources:Strings.Set}" Command="{Binding Data.SetAliasCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedAlias}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="176" />
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Serial}" Binding="{Binding Serial, Converter={StaticResource IntToHexStringValueConverter}}" Width="176" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 10,0,0">
                                <StackPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                    </Style>
                                </StackPanel.Styles>
                                <Button Content="{x:Static resources:Strings.Close}">
                                    <Interaction.Behaviors>
                                        <behaviours:CloseOnClickBehaviour />
                                    </Interaction.Behaviors>
                                </Button>
                                <Button Content="{x:Static resources:Strings.Refresh}" Command="{Binding RefreshAliasesCommand}" />
                                <Button Content="{x:Static resources:Strings.Clear_All_Objects}" Command="{Binding ClearAllAliasesCommand}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{x:Static resources:Strings.Instance}">
                        <TabItem.Resources>
                            <ResourceDictionary>
                                <!-- MIGRATION: CollectionViewSource removed - group in ViewModel instead -->
                            </ResourceDictionary>
                        </TabItem.Resources>
                        <DataGrid SelectedItem="{Binding SelectedInstanceAlias}" Margin="5" ItemsSource="{Binding Source={DynamicResource src}}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                                <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemoveInstanceAliasCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedInstanceAlias}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <!-- MIGRATION: ItemContainerStyle removed - port to RowTheme -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="176" />
                                <DataGridTextColumn Header="{x:Static resources:Strings.Serial}" Binding="{Binding Serial, Converter={StaticResource IntToHexStringValueConverter}}" Width="156" />
                            </DataGrid.Columns>
                            <!-- MIGRATION: GroupStyle removed - restructure grouping manually -->
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{x:Static resources:Strings.Player}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid SelectedItem="{Binding SelectedPlayerAlias}" ItemsSource="{Binding PlayerAliases}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemovePlayerAliasCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedPlayerAlias}" />
                                        <MenuItem Header="{x:Static resources:Strings.Set}" Command="{Binding Data.SetPlayerAliasCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedPlayerAlias}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="176" />
                                    <DataGridTextColumn Header="{x:Static resources:Strings.Serial}" Binding="{Binding Serial, Converter={StaticResource IntToHexStringValueConverter}}" Width="176" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 10,0,0">
                                <StackPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                    </Style>
                                </StackPanel.Styles>
                                <Button Content="{x:Static resources:Strings.Close}">
                                    <Interaction.Behaviors>
                                        <behaviours:CloseOnClickBehaviour />
                                    </Interaction.Behaviors>
                                </Button>
                                <Button Content="{x:Static resources:Strings.Refresh}" Command="{Binding RefreshPlayerAliasesCommand}" />
                                <Button Content="{x:Static resources:Strings.Clear_All_Objects}" Command="{Binding ClearAllPlayerAliasesCommand}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="{x:Static resources:Strings.Lists}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox SelectedItem="{Binding SelectedList}" ItemsSource="{Binding Lists}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemoveListCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Data.SelectedList, Source={StaticResource Proxy}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="False" Header="{Binding Name}">
                                    <ItemsControl ItemsSource="{Binding Serials}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Mode=OneWay}" Margin="25,0,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 10,0,0">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Content="{x:Static resources:Strings.Close}">
                            <Interaction.Behaviors>
                                <behaviours:CloseOnClickBehaviour />
                            </Interaction.Behaviors>
                        </Button>
                        <Button Content="{x:Static resources:Strings.Refresh}" Command="{Binding RefreshListsCommand}" />
                        <Button Content="{x:Static resources:Strings.Clear_All_Objects}" Command="{Binding ClearAllListsCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static resources:Strings.Timers}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid SelectedItem="{Binding SelectedTimer}" ItemsSource="{Binding Timers}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="176" />
                            <DataGridTextColumn Header="{x:Static resources:Strings.Value}" Binding="{Binding Value, Converter={StaticResource IntToHexStringValueConverter}}" Width="176" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 10,0,0">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Content="{x:Static resources:Strings.Close}">
                            <Interaction.Behaviors>
                                <behaviours:CloseOnClickBehaviour />
                            </Interaction.Behaviors>
                        </Button>
                        <Button Content="{x:Static resources:Strings.Refresh}" Command="{Binding RefreshTimersCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static resources:Strings.Ignore_List}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="listBox" SelectedItem="{Binding SelectedIgnoreEntry}" ItemsSource="{Binding IgnoreEntries}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding Data.RemoveIgnoreEntryCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding SelectedIgnoreEntry}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}0x{0:x}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 10,0,0">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Content="{x:Static resources:Strings.Close}">
                            <Interaction.Behaviors>
                                <behaviours:CloseOnClickBehaviour />
                            </Interaction.Behaviors>
                        </Button>
                        <Button Content="{x:Static resources:Strings.Refresh}" Command="{Binding RefreshIgnoreListCommand}" />
                        <Button Content="{x:Static resources:Strings.Clear_All}" Command="{Binding ClearIgnoreListCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
