<Window xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:converters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ecv="clr-namespace:ClassicAssist.UI.Views.ECV" xmlns:filter="clr-namespace:ClassicAssist.UI.Views.ECV.Filter" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="window" x:Class="ClassicAssist.UI.Views.EntityCollectionViewer" mc:Ignorable="d" Background="{DynamicResource ThemeBackgroundBrush}" Width="600" Title="{x:Static resources:Strings.Entity_Collection_Viewer}" MinHeight="400" Height="600" d:DataContext="{d:DesignInstance Type=viewModels:EntityCollectionViewerViewModel, IsDesignTimeCreatable=True}" Topmost="{Binding Options.AlwaysOnTop}" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:models="clr-namespace:ClassicAssist.UI.Models" xmlns:local="clr-namespace:ClassicAssist.UI.Views" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:EnumMatchToBooleanConverter x:Key="EnumMatchToBooleanConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/Icons.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/Toolbar.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/ListStyles.axaml" />
    </Window.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="{DynamicResource ThemeBackgroundBrush}" Classes="ToolBarStyle1">
            <Button Height="24" Padding="0" Command="{Binding RefreshCommand}" ToolTip.Tip="{x:Static resources:Strings.Refresh}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource RefreshIcon}" />
            </Button>
            <ToggleButton Height="24" Command="{Binding TogglePropertiesCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}" ToolTip.Tip="{x:Static resources:Strings.Toggle_item_properties}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource ListIcon}" />
            </ToggleButton>
            <ToggleButton x:Name="toggleButton" Height="24" IsChecked="{Binding ShowFilter}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource FilterIcon}" />
            </ToggleButton>
            <ToggleButton Height="24" IsChecked="{Binding ShowOrganizer}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource OrganizeIcon}" />
            </ToggleButton>
            <ToggleButton Height="24" Command="{Binding ToggleChildItemsCommand}" IsChecked="{Binding Options.ShowChildItems}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}" ToolTip.Tip="{x:Static resources:Strings.Show_Child_Items}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource BabyIcon}" />
            </ToggleButton>
            <ToggleButton Height="24" Command="{Binding ToggleAlwaysOnTopCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}" IsChecked="{Binding Options.AlwaysOnTop}" ToolTip.Tip="{x:Static resources:Strings.Always_On_Top}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource PinIcon}" />
            </ToggleButton>
            <Button Height="24" Padding="0" Command="{Binding OpenAllContainersCommand}" ToolTip.Tip="{x:Static resources:Strings.Open_All_Containers}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource ContainerIcon}" Height="19" />
            </Button>
            <Menu Background="Transparent" Height="24">
                <MenuItem Height="24">
                    <MenuItem.Header>
                        <Image Source="{DynamicResource SortIcon}" Height="19" Width="19" />
                    </MenuItem.Header>
                    <MenuItem Header="{x:Static resources:Strings.Name}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.Name}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.Name}" />
                    <MenuItem Header="{x:Static resources:Strings.Serial}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.Serial}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.Serial}" />
                    <MenuItem Header="{x:Static resources:Strings.Color}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.Hue}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.Hue}" />
                    <MenuItem Header="{x:Static resources:Strings.Graphic}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.ID}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.ID}" />
                    <MenuItem Header="{x:Static resources:Strings.Amount}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.Quantity}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.Quantity}" />
                    <MenuItem Header="{x:Static resources:Strings.Item_Weight}" ToggleType="CheckBox" IsChecked="{Binding SortStyle, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static models:EntityCollectionSortStyle.Weight}}" Command="{Binding ChangeSortStyleCommand}" CommandParameter="{x:Static models:EntityCollectionSortStyle.Weight}" />
                </MenuItem>
            </Menu>
            <Button Height="24" Command="{Binding CombineStacksCommand}" ToolTip.Tip="{x:Static resources:Strings.Combine_stacks}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource consolidateIcon}" />
            </Button>
            <Button Height="20" Padding="0" Command="{Binding ReplaceNameCommand}" ToolTip.Tip="{x:Static resources:Strings.Replace_name_with_single_click_label}" IsVisible="{Binding TooltipsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource HandPointerIcon}" />
                <!-- MIGRATION: check visibility converter 'InverseBooleanToVisibilityConverter' -->
            </Button>
            <Button Height="24" Command="{Binding TargetContainerCommand}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource CrosshairIcon}" />
            </Button>
            <Button Height="24" Command="{Binding AutolootContainerCommand}" ToolTip.Tip="{x:Static resources:Strings.Autoloot}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource AutoLootIcon}" />
            </Button>
            <ToggleButton Height="24" Command="{Binding ToggleHideLockedItemsCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}" IsChecked="{Binding Options.HideLockedItems}" ToolTip.Tip="{x:Static resources:Strings.Hide_Locked_Items}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource HideLockedIcon}" />
            </ToggleButton>
            <ToggleButton Height="24" Command="{Binding ToggleEnableHotkeysCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}" IsChecked="{Binding Options.EnableHotkeys}" ToolTip.Tip="{x:Static resources:Strings.Enable_Hotkeys}" Classes="ToolbarToggleButtonStyle">
                <Image Source="{DynamicResource KeyboardIcon}" />
            </ToggleButton>
            <Button Height="24" Command="{Binding ConfigureCommand}" Classes="ToolbarButtonStyle">
                <Image Source="{DynamicResource configureIcon}" />
            </Button>
            <ItemsControl ItemsSource="{Binding CustomToolbarActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="24" Padding="0" Command="{Binding ExecuteCommand}" ToolTip.Tip="{Binding Name}">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                    <Style Selector="^:disabled">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Style>
                                </Style>
                            </Button.Styles>
                            <Image Source="{Binding Icon}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowFilter}">
            <filter:EntityCollectionFilterControl MaxHeight="400" Command="{Binding DataContext.ApplyFiltersCommand, ElementName=window}" IsFilterApplied="{Binding DataContext.IsFilterApplied, ElementName=window, Mode=OneWay}" Assemblies="{Binding DataContext.Options.Assemblies, ElementName=window}" />
        </ScrollViewer>
        <Grid Grid.Row="2" IsVisible="{Binding ShowOrganizer}">
            <ecv:EntityCollectionViewerOrganizerControl Collection="{Binding DataContext.Collection, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EntityCollectionViewer}}}" QueueActions="{Binding DataContext.QueueActions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EntityCollectionViewer}}}" />
        </Grid>
        <ListBox x:Name="listView" BorderThickness="0" MinHeight="200" Background="{DynamicResource ThemeInnerControlBackgroundBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="3" ItemsSource="{Binding Entities}" Classes="EntityListViewStyle">
            <Interaction.Behaviors>
                <behaviours:MultiSelectionBehaviour SelectedItems="{Binding SelectedItems}" />
            </Interaction.Behaviors>
            <ListBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" />
                <KeyBinding Gesture="C" Command="{Binding HotkeyActionCommand}" CommandParameter="Container" />
                <KeyBinding Gesture="B" Command="{Binding HotkeyActionCommand}" CommandParameter="Backpack" />
                <KeyBinding Gesture="K" Command="{Binding HotkeyActionCommand}" CommandParameter="Bank" />
                <KeyBinding Gesture="G" Command="{Binding HotkeyActionCommand}" CommandParameter="Ground" />
                <KeyBinding Gesture="D" Command="{Binding HotkeyActionCommand}" CommandParameter="Drop" />
            </ListBox.KeyBindings>
        </ListBox>
        <ItemsControl Grid.Row="4" ItemsSource="{Binding QueueActions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.Styles>
                            <Style Selector="Grid">
                                <Setter Property="IsVisible" Value="True" />
                                <Setter Property="(Classes.Cancelling)" Value="{Binding Status, Converter={x:Static valueConverters:ValueEqualityConverter.Instance}, ConverterParameter={x:Static resources:Strings.Cancel}}" />
                                <Style Selector="^.Cancelling">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                            </Style>
                        </Grid.Styles>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeForegroundBrush}" Padding="3,0,0,0" Grid.Column="0" VerticalAlignment="Center" />
                        <Button Command="{Binding CancelCommand}" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" Grid.Column="1" Padding="0" ToolTip.Tip="{x:Static resources:Strings.Cancel}">
                            <Image Source="{DynamicResource CancelIcon}" Height="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="5" Background="{DynamicResource ThemeBackgroundBrush}">
            <TextBlock Text="{Binding StatusLabel}" />
        </StackPanel>
    </Grid>
</Window>
