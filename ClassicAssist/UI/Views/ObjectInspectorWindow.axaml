<Window xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:ClassicAssist.UI.Models" xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.ObjectInspectorWindow" mc:Ignorable="d" Topmost="True" Title="{x:Static resources:Strings.Object_Inspector}" Height="396.8" Width="450" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <viewModels:ObjectInspectorViewModel x:Key="DummyData">
                <viewModels:ObjectInspectorViewModel.Items>
                    <models:ObjectInspectorData Category="Category" Name="Name" Value="Value" IsExpanded="False" />
                    <models:ObjectInspectorData Category="Category 2" Name="Name" Value="Value" />
                </viewModels:ObjectInspectorViewModel.Items>
            </viewModels:ObjectInspectorViewModel>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
    </Window.Styles>
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" />
    </Window.KeyBindings>
    <Grid d:DataContext="{StaticResource DummyData}">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- MIGRATION: CollectionViewSource removed - group in ViewModel instead -->
            </ResourceDictionary>
        </Grid.Resources>
        <DataGrid SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ItemsSource="{Binding Source={DynamicResource src}}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
            <Interaction.Behaviors>
                <behaviours:ListViewDoubleClickBehaviour />
            </Interaction.Behaviors>
            <!-- MIGRATION: ItemContainerStyle removed - port to RowTheme -->
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Property}" Width="156">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" d:DataContext="{d:DesignInstance models:ObjectInspectorData}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                                <Image Grid.Column="1" MaxHeight="12" Source="{DynamicResource PointerIcon}" d:DataContext="{d:DesignInstance models:ObjectInspectorData}">
                                    <Image.Styles>
                                        <Style Selector="Image">
                                            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding OnDoubleClick}" />
                                            <Setter Property="ca:TriggerCondition.Value" Value="{x:Null}" />
                                            <Style Selector="^.ca-dt1">
                                                <Setter Property="IsVisible" Value="False" />
                                            </Style>
                                        </Style>
                                    </Image.Styles>
                                </Image>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static resources:Strings.Value}" Width="256">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" d:DataContext="{d:DesignInstance models:ObjectInspectorData}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <!-- MIGRATION: GroupStyle removed - restructure grouping manually -->
        </DataGrid>
    </Grid>
</Window>
