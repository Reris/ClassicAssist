<UserControl xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.Filters.ItemIDFilter.ItemIDTooltipControl" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <valueConverters:IntToHexStringValueConverter x:Key="IntToHexStringValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </UserControl.Styles>
    <Grid DataContext="{Binding ElementName=userControl}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="{Binding Image}" />
        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0" Grid.Column="1">
            <TextBlock Text="{Binding ItemID, Converter={StaticResource IntToHexStringValueConverter}}" />
            <TextBlock Text="{Binding ItemName}" />
        </StackPanel>
    </Grid>
</UserControl>
