<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Filters.LightLevelFilterConfigureWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Light_Level}" Width="400" SizeToContent="Height" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Topmost="True" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Header="{x:Static resources:Strings.Options}">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel.Styles>
                        <Style Selector="RadioButton">
                            <Setter Property="Margin" Value="0,0,10,0" />
                        </Style>
                    </StackPanel.Styles>
                    <RadioButton Content="{x:Static resources:Strings.Fixed}" IsChecked="{Binding Options.IsFixed}" />
                    <RadioButton Content="{x:Static resources:Strings.Min___Max}" IsChecked="{Binding Options.IsMinMax}" />
                </StackPanel>
                <Grid>
                    <Grid.Styles>
                        <Style Selector="Slider">
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="Maximum" Value="31" />
                            <Setter Property="IsDirectionReversed" Value="True" />
                            <Setter Property="IsSnapToTickEnabled" Value="True" />
                            <Setter Property="TickFrequency" Value="1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,5,0,5" />
                        </Style>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                        </Style>
                    </Grid.Styles>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.Light_Level_}" IsVisible="{Binding Options.IsFixed}" />
                    <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Options.FixedLevel}" IsVisible="{Binding Options.IsFixed}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Options.FixedLevel}" HorizontalAlignment="Right" Margin="0" IsVisible="{Binding Options.IsFixed}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resources:Strings.Brightest_}" IsVisible="{Binding Options.IsMinMax}" />
                    <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Options.MinLevel}" IsVisible="{Binding Options.IsMinMax}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Options.MinLevel}" HorizontalAlignment="Right" Margin="0" IsVisible="{Binding Options.IsMinMax}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resources:Strings.Darkest_}" IsVisible="{Binding Options.IsMinMax}" />
                    <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Options.MaxLevel}" IsVisible="{Binding Options.IsMinMax}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Options.MaxLevel}" HorizontalAlignment="Right" Margin="0" IsVisible="{Binding Options.IsMinMax}" />
                </Grid>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static resources:Strings.Close}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
