<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:filters="clr-namespace:ClassicAssist.UI.ViewModels.Filters" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Filters.ClilocFilterConfigureWindow" mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Cliloc_Filter}" Height="450" Width="625" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:CellWidthValueConverter x:Key="CellWidthValueConverter" />
            <misc:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <filters:ClilocFilterConfigureViewModel x:Key="Dummy">
                <filters:ClilocFilterConfigureViewModel.Items>
                    <filters:FilterClilocEntry />
                </filters:ClilocFilterConfigureViewModel.Items>
            </filters:ClilocFilterConfigureViewModel>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/Debug/Styles.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <filters:ClilocFilterConfigureViewModel />
    </Window.DataContext>
    <Grid Margin="10" d:DataContext="{StaticResource Dummy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Classes="ToolBarStyle1">
            <controls:ImageButton Command="{Binding AddItemCommand}" ImageSource="{DynamicResource AddIcon}" ToolTip.Tip="{x:Static resources:Strings.Add}" />
            <controls:ImageButton Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=listView}" ImageSource="{DynamicResource RemoveIcon}" ToolTip.Tip="{x:Static resources:Strings.Remove}" />
        </StackPanel>
        <Grid Margin="0,10" Grid.Row="1">
            <DataGrid x:Name="listView" Foreground="Black" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent">
                    <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static resources:Strings.Remove}" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <!-- MIGRATION: ItemContainerStyle removed - port to RowTheme -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.ID}" Width="106">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="filters:FilterClilocEntry">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Cliloc}" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" />
                                    <controls:ImageButton ImageSource="{DynamicResource ExportIcon}" HorizontalAlignment="Right" Grid.Column="1" CommandParameter="{Binding}" Command="{Binding Path=Data.(filters:ClilocFilterConfigureViewModel).ChooseClilocCommand, Source={StaticResource Proxy}}" ToolTip.Tip="{x:Static resources:Strings.Choose_by_Cliloc}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static resources:Strings.Original}" Binding="{Binding Original}" Width="156" />
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Replacement}" Width="156">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="filters:FilterClilocEntry">
                                <controls:EditTextBlock Foreground="{DynamicResource ThemeForegroundBrush}" Text="{Binding Replacement, Mode=TwoWay}" MinWidth="100" ShowIcon="True" Width="{Binding Path=Width, ElementName=ReplacementColumnHeader, Converter={StaticResource CellWidthValueConverter}, ConverterParameter=15}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Hue_Override}" Width="86">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="filters:FilterClilocEntry">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Hue}" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" />
                                    <controls:ImageButton ImageSource="{DynamicResource ColorWheelIcon}" HorizontalAlignment="Right" Grid.Column="1" CommandParameter="{Binding}" Command="{Binding Path=Data.(filters:ClilocFilterConfigureViewModel).SelectHueCommand, Source={StaticResource Proxy}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Show_Overhead}" Width="106">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="filters:FilterClilocEntry">
                                <CheckBox IsChecked="{Binding ShowOverhead}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{x:Static resources:Strings.Display_system_message_as_overhead_message}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OKCommand}" Margin="5">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}" Margin="5">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
