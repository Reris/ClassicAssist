<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.Filters.RepeatedMessagesFilterConfigureWindow" Topmost="True" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Title="{x:Static resources:Strings.Repeated_Messages}" Height="350" Width="400" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Header="{x:Static resources:Strings.Options}">
            <GroupBox.Styles>
                <Style Selector="NumericUpDown">
                    <Setter Property="Margin" Value="10,0,10,0" />
                </Style>
            </GroupBox.Styles>
            <StackPanel Margin="10">
                <CheckBox IsChecked="{Binding Options.SendToJournal}">
                    <TextBlock Text="{x:Static resources:Strings.Journal_receives_filtered_messages}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static resources:Strings.Message_Limit_}" />
                    <NumericUpDown Minimum="0" Value="{Binding Options.MessageLimit}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static resources:Strings.Time_Limit_}" />
                    <NumericUpDown Minimum="0" Value="{Binding Options.TimeLimit}" />
                    <TextBlock Text="{x:Static resources:Strings.seconds}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static resources:Strings.Filtered_Time_}" />
                    <NumericUpDown Minimum="0" Value="{Binding Options.BlockedTime}" />
                    <TextBlock Text="{x:Static resources:Strings.seconds}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static resources:Strings.Close}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
