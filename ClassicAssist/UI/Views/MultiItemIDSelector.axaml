<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.UI.Views.MultiItemIDSelector" mc:Ignorable="d" d:DesignWidth="400" xmlns:local="clr-namespace:ClassicAssist.UI.Views" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <misc:BindingProxy x:Key="Proxy" Data="{Binding Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MultiItemIDSelector}}}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <controls:MultiValueSelector Values="{Binding Values}" HexDisplay="True">
        <controls:MultiValueSelector.Buttons>
            <controls:ImageButton ImageSource="{DynamicResource CrosshairIcon}" Margin="5,0,0,0" Command="{Binding Data.TargetCommand, Source={StaticResource Proxy}}" />
        </controls:MultiValueSelector.Buttons>
        <controls:MultiValueSelector.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding ., StringFormat={}0x{0:x8}}" Foreground="{DynamicResource ThemeForegroundBrush}" />
            </DataTemplate>
        </controls:MultiValueSelector.ItemTemplate>
    </controls:MultiValueSelector>
</UserControl>
