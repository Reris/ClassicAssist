<Window xmlns="https://github.com/avaloniaui" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.SplashWindow" mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="Transparent" Title="{x:Static resources:Strings.ProductName}" SizeToContent="WidthAndHeight" Topmost="True" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ClassicAssist.UI.Views" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared">
    <Image Opacity="0.9" Source="{Binding Path=Image, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SplashWindow}}}" Stretch="None" />
</Window>
