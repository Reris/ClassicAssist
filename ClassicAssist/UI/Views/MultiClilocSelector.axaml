<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:ClassicAssist.Misc" xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.MultiClilocSelector" mc:Ignorable="d" d:DesignWidth="600" xmlns:local="clr-namespace:ClassicAssist.UI.Views" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <misc:BindingProxy x:Key="Proxy" Data="{Binding Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MultiClilocSelector}}}" />
            <valueConverters:ClilocValueConverter x:Key="ClilocValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <controls:MultiValueSelector Values="{Binding Values}" PopupWidth="400">
        <controls:MultiValueSelector.Buttons>
            <StackPanel Orientation="Horizontal">
                <controls:ImageButton ImageSource="{DynamicResource ExportIcon}" Margin="5,0,0,0" Command="{Binding Data.ChooseClilocCommand, Source={StaticResource Proxy}}" ToolTip.Tip="{x:Static resources:Strings.Choose_by_Cliloc}" />
                <controls:ImageButton ImageSource="{DynamicResource CrosshairIcon}" Margin="5,0,0,0" Command="{Binding Data.ChooseFromItemCommand, Source={StaticResource Proxy}}" ToolTip.Tip="{x:Static resources:Strings.Choose_from_Item}" />
            </StackPanel>
        </controls:MultiValueSelector.Buttons>
        <controls:MultiValueSelector.ItemTemplate>
            <DataTemplate>
                <TextBlock Foreground="{DynamicResource ThemeForegroundBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} ({1})">
                            <Binding Path="." />
                            <Binding Path="." Converter="{StaticResource ClilocValueConverter}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>
        </controls:MultiValueSelector.ItemTemplate>
    </controls:MultiValueSelector>
</UserControl>
