<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:general="clr-namespace:ClassicAssist.UI.Views.General" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Views.General.AutologinConfigureWindow" mc:Ignorable="d" Title="{x:Static resources:Strings.Autologin}" Width="300" SizeToContent="Height" Background="{DynamicResource WindowBackgroundBrush}" Topmost="True" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.axaml" />
    </Window.Styles>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Margin" Value="0,0,10,5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>
                <Style Selector="NumericUpDown">
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                </Style>
            </Grid.Styles>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.Account}" />
            <ComboBox x:Name="comboBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Accounts}">
                <ComboBox.SelectedItem>
                    <Binding Path="Account" />
                </ComboBox.SelectedItem>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resources:Strings.Server_Index}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ServerIndex}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resources:Strings.Character_Index}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CharacterIndex}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static resources:Strings.Connect_Delay}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ConnectDelay}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static resources:Strings.Reconnect_Delay}" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReconnectDelay}" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="5,0,0,0" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OkCommand}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Path=(DataValidationErrors.HasErrors),ElementName=comboBox, Mode=OneWay}" />
                        <Setter Property="ca:TriggerCondition.Value" Value="False" />
                        <Style Selector="^.ca-dt1">
                            <Setter Property="IsEnabled" Value="True" />
                        </Style>
                    </Style>
                </Button.Styles>
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
            <Button Content="{x:Static resources:Strings.Cancel}">
                <Interaction.Behaviors>
                    <behaviours:CloseOnClickBehaviour />
                </Interaction.Behaviors>
            </Button>
        </StackPanel>
    </Grid>
</Window>
