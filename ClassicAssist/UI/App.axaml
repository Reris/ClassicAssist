<Application xmlns="https://github.com/avaloniaui"
             RequestedThemeVariant="Dark"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassicAssist.UI.App">
    <Application.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/Toolbar.axaml" />
        <StyleInclude Source="avares://ClassicAssist/UI/Views/ECV/ListStyles.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/MenuStyles.axaml" />
    </Application.Styles>
</Application>