<UserControl xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Controls.HexDumpControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="600" xmlns:local="clr-namespace:ClassicAssist.UI.Controls" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <Style Selector="TextBlock.TextBlockStyle">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </UserControl.Styles>
    <StackPanel DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:HexDumpControl}}}">
        <Label Content="{Binding Packet.Title}" />
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static resources:Strings.Copy_packet_declaration}" Click="Copy_OnClick" />
                    <MenuItem Header="{x:Static resources:Strings.Replay}" Click="Replay_OnClick" />
                    <MenuItem Header="{x:Static resources:Strings.Ignore_packet_type}" Click="Ignore_OnClick" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding BinaryData}" Grid.Column="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="10,10,0,0" Width="310" Classes="TextBlockStyle" />
            <TextBlock Text="{Binding TextData}" Grid.Column="1" Margin="10,10,0,0" ScrollViewer.VerticalScrollBarVisibility="Disabled" Classes="TextBlockStyle" />
        </Grid>
        <Label Content="{Binding Status}" />
    </StackPanel>
</UserControl>
