<UserControl xmlns="https://github.com/avaloniaui" xmlns:Interaction="using:Avalonia.Xaml.Interactivity" xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.UI.Controls.CustomWindowTitleControl" mc:Ignorable="d" x:Name="UserControl" d:DesignHeight="50" d:DesignWidth="800" Background="{DynamicResource ThemeWindowBackgroundBrush}" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared" xmlns:sharedBehaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
    </UserControl.Styles>
    <Interaction.Behaviors>
        <sharedBehaviours:DoubleClickBehaviour Command="{Binding MaximizeCommand, ElementName=UserControl}" CommandParameter="{Binding ElementName=UserControl, Mode=OneWay}" />
        <behaviours:WindowMouseDownBehaviour />
    </Interaction.Behaviors>
    <Grid Margin="5">
        <Grid.Styles>
            <Style Selector="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </Grid.Styles>
        <ContentPresenter Content="{Binding AdditionalContent, ElementName=UserControl}" DockPanel.Dock="Left" />
        <Label DockPanel.Dock="Left" Content="{Binding CustomTitle, ElementName=UserControl}" FontSize="16" Margin="5,0,5,0" Foreground="{DynamicResource ThemeForegroundBrush}" />
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
            <ContentPresenter Content="{Binding AdditionalButtons, ElementName=UserControl}" />
            <Button Background="{DynamicResource ThemeWindowBackgroundBrush}" IsEnabled="{Binding CanMinimize, ElementName=UserControl}">
                <Interaction.Behaviors>
                    <behaviours:WindowCommandBehaviour Command="Minimize" MinimizeCommand="{Binding Path=MinimizeCommand, ElementName=UserControl}" />
                </Interaction.Behaviors>
                <Image Source="{DynamicResource minusIcon}" />
            </Button>
            <Button Background="{DynamicResource ThemeWindowBackgroundBrush}" IsEnabled="{Binding CanMaximize, ElementName=UserControl}">
                <Interaction.Behaviors>
                    <behaviours:WindowCommandBehaviour Command="Maximize" />
                </Interaction.Behaviors>
                <Image Source="{DynamicResource squareIcon}" />
            </Button>
            <Button Background="{DynamicResource ThemeWindowBackgroundBrush}" IsEnabled="{Binding CanClose, ElementName=UserControl}">
                <Interaction.Behaviors>
                    <behaviours:WindowCommandBehaviour Command="Close" />
                </Interaction.Behaviors>
                <Image Source="{DynamicResource closeIcon}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
