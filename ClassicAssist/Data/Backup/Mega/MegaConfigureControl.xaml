<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ClassicAssist.Controls;assembly=ClassicAssist.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mega="clr-namespace:ClassicAssist.Data.Backup.Mega" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Data.Backup.Mega.MegaConfigureControl" mc:Ignorable="d" x:Name="Control" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary />
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/DarkTheme.xaml" />
        <Style Selector="Panel.HideOnLoggedIn">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsLoggedIn}" />
            <Setter Property="ca:TriggerCondition.Value" Value="True" />
            <Style Selector="^.ca-dt1">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="StackPanel.ShowOnLoggedIn">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsLoggedIn}" />
            <Setter Property="ca:TriggerCondition.Value" Value="True" />
            <Style Selector="^.ca-dt2">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="TextBlock.HideIfEmpty">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="ca:TriggerCondition.Bind" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ca:TriggerCondition.Value" Value="" />
            <Style Selector="^.ca-dt3">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
    </UserControl.Styles>
    <UserControl.DataContext>
        <mega:MegaConfigureViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Classes="HideOnLoggedIn">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:HeaderTextBox Grid.Row="0" Header="{x:Static resources:Strings.Username}" Value="{Binding DataContext.Username, ElementName=Control}" />
            <controls:HeaderTextBox Grid.Row="1" Header="{x:Static resources:Strings.Password}" Value="{Binding DataContext.Password, ElementName=Control}" />
            <Button Grid.Row="2" Content="{x:Static resources:Strings.Login}" Command="{Binding LoginCommand}" />
            <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" TextAlignment="Center" VerticalAlignment="Center" Classes="HideIfEmpty" />
            <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="5" IsVisible="{Binding IsWorking}" />
        </Grid>
        <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Classes="ShowOnLoggedIn">
            <Button Content="{x:Static resources:Strings.Logout}" Command="{Binding LogoutCommand}" Margin="0,0,0,10" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Classes="ShowOnLoggedIn">
            <TextBlock Text="{x:Static resources:Strings.Overwrite_Existing}" Width="100" ToolTip.Tip="{x:Static resources:Strings.Overwrite_existing_files_instead_of_creating_new_files_with_the_same_name}" />
            <CheckBox IsChecked="{Binding OverwriteExisting}" />
        </StackPanel>
    </Grid>
</UserControl>
