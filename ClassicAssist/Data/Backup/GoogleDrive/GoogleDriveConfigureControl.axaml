<UserControl xmlns="https://github.com/avaloniaui" xmlns:googleDrive="clr-namespace:ClassicAssist.Data.Backup.GoogleDrive" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Data.Backup.GoogleDrive.GoogleDriveConfigureControl" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary />
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist/Resources/Theme.axaml" />
        <Style Selector="TextBlock.HideIfEmpty">
            <Setter Property="IsVisible" Value="True" />
            <Style Selector="^.Empty">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="StackPanel.HideOnLoggedIn">
            <Setter Property="IsVisible" Value="True" />
            <Style Selector="^.LoggedIn">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="StackPanel.ShowOnLoggedIn">
            <Setter Property="IsVisible" Value="False" />
            <Style Selector="^.LoggedIn">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
    </UserControl.Styles>
    <UserControl.DataContext>
        <googleDrive:GoogleDriveConfigureViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Classes="HideOnLoggedIn" Classes.LoggedIn="{Binding IsLoggedIn}">
            <Button Content="{x:Static resources:Strings.Login_With_Google}" Command="{Binding LoginCommand}" />
            <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" Classes="HideIfEmpty" Classes.Empty="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
        </StackPanel>
        <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Classes="ShowOnLoggedIn" Classes.LoggedIn="{Binding IsLoggedIn}">
            <Button Content="{x:Static resources:Strings.Logout}" Command="{Binding LogoutCommand}" />
        </StackPanel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="5" IsVisible="{Binding IsWorking}" />
    </Grid>
</UserControl>
