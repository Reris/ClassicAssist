<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared">
    <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.axaml" />
    <Style Selector="ToggleButton.LeftRightIconToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Image>
                        <Image.Styles>
                            <Style Selector="Image">
                                <Setter Property="(Classes.Checked)" Value="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="(Classes.Unchecked)" Value="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Style Selector="^.Checked">
                                    <Setter Property="Source" Value="{DynamicResource RightChevron}" />
                                    <Setter Property="ToolTip.Tip" Value="{x:Static resources:Strings.Show}" />
                                </Style>
                                <Style Selector="^.Unchecked">
                                    <Setter Property="Source" Value="{DynamicResource LeftChevron}" />
                                    <Setter Property="ToolTip.Tip" Value="{x:Static resources:Strings.Hide}" />
                                </Style>
                            </Style>
                        </Image.Styles>
                    </Image>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Styles>
