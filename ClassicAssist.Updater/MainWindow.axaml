<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:local="clr-namespace:ClassicAssist.Updater" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:valueConverters="clr-namespace:ClassicAssist.Shared.UI.ValueConverters;assembly=ClassicAssist.Shared" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Updater.MainWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static properties:Resources.ClassicAssist_Updater}" Height="400" Width="400" WindowStartupLocation="CenterScreen" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:properties="clr-namespace:ClassicAssist.Updater.Properties" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary>
            <valueConverters:InverseBooleanValueConverter x:Key="InverseBooleanValueConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles />
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ProgressBar Height="7" IsIndeterminate="{Binding IsIndeterminate}" Maximum="{Binding DownloadSize}" Grid.Row="0" IsVisible="{Binding IsUpdating}" />
        <Grid Grid.Row="1" Margin="10">
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding Items}">
                <Interaction.Behaviors>
                    <behaviours:ItemsControlAutoScrollBehaviour />
                </Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <CheckBox Content="{x:Static properties:Resources.Install_Prereleases}" IsChecked="{Binding UpdaterSettings.InstallPrereleases}" />
                <CheckBox Content="{x:Static properties:Resources.Force_Update}" Margin="10,0,0,0" IsChecked="{Binding Force}" />
            </StackPanel>
            <Button DockPanel.Dock="Left" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Content="{x:Static properties:Resources.Releases}"
                    Tag="https://github.com/Reetus/ClassicAssist/releases" Click="Hyperlink_OnRequestNavigate" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button Margin="0,0,10,0" Command="{Binding CheckForUpdateCommand}" ToolTip.Tip="{x:Static resources:Strings.Check_For_Updates}">
                    <Button.Content>
                        <Image Source="{DynamicResource RefreshIcon}" Height="16" />
                    </Button.Content>
                </Button>
                <Button Content="{x:Static properties:Resources.Close}" Width="100" HorizontalAlignment="Right" IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanValueConverter}}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
