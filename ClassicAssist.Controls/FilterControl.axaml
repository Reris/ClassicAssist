<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.Controls.FilterControl" mc:Ignorable="d" d:DesignHeight="22" d:DesignWidth="200" xmlns:ca="clr-namespace:ClassicAssist.Shared.UI.Compat;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Colours.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DarkTheme.xaml" />
    </UserControl.Styles>
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.Styles>
            <Style Selector="Grid">
                <Setter Property="ca:TriggerCondition.Key" Value="dt1" />
                <Setter Property="ca:TriggerCondition.Bind" Value="{Binding IsFilterVisible, ElementName=userControl}" />
                <Setter Property="ca:TriggerCondition.Value" Value="True" />
                <Style Selector="^.ca-dt1">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Grid.Styles>
        <Image Height="14" Source="{DynamicResource SearchIcon}" Grid.Column="0" />
        <TextBox Margin="5,0,0,0" x:Name="textBox" Text="{Binding FilterText, ElementName=userControl}" HorizontalContentAlignment="Stretch" Grid.Column="1">
            <Interaction.Behaviors>
                <behaviours:AutoFocusBehaviour />
            </Interaction.Behaviors>
        </TextBox>
        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="-15, 0,0,0" Command="{Binding CloseCommand, ElementName=userControl}" Grid.Column="2">
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="IsVisible" Value="False" />
                    <Setter Property="ca:TriggerCondition.Key" Value="dt2" />
                    <Setter Property="ca:TriggerCondition.Bind" Value="{Binding ShowCloseButton, ElementName=userControl}" />
                    <Setter Property="ca:TriggerCondition.Value" Value="True" />
                    <Style Selector="^.ca-dt2">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
            </Button.Styles>
            <Image Height="8" Source="{DynamicResource closeIcon}" />
        </Button>
    </Grid>
</UserControl>
