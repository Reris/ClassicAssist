<UserControl xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Controls.Misc.Behaviours" xmlns:controls="clr-namespace:ClassicAssist.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="userControl" x:Class="ClassicAssist.Controls.MultiValueSelector" mc:Ignorable="d" d:DesignWidth="400" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="DefaultItemTemplate">
                <TextBlock Text="{Binding ., StringFormat={}0x{0:x8}}" Foreground="{DynamicResource ThemeForegroundBrush}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Icons.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Colours.xaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DarkTheme.xaml" />
    </UserControl.Styles>
    <Grid>
        <Grid DataContext="{Binding ElementName=userControl, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ValuesDisplay}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding ValuesDisplay}" />
            <controls:ImageButton Grid.Column="1" ImageSource="{DynamicResource EllipsisIcon}" Click="Button_Click" />
        </Grid>
        <Popup x:Name="Popup" IsLightDismissEnabled="True" Opened="Popup_Opened">
            <Border Padding="5">
                <StackPanel Width="{Binding ElementName=userControl, Path=PopupWidth}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TextBox" Grid.Column="0" KeyDown="TextBox_PreviewKeyDown" />
                        <ContentPresenter HorizontalAlignment="Right" Content="{Binding Buttons, ElementName=userControl}" Grid.Column="1" />
                    </Grid>
                    <Border MinHeight="150" MaxHeight="300" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}" Margin="0,5,0,0">
                        <ItemsControl Background="{DynamicResource ThemeInnerControlBackgroundBrush}" ItemsSource="{Binding Values, ElementName=userControl, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0" Content="{Binding}">
                                            <ContentPresenter.ContentTemplate>
                                                <Binding Path="ItemTemplate" ElementName="userControl" FallbackValue="{StaticResource DefaultItemTemplate}" />
                                            </ContentPresenter.ContentTemplate>
                                        </ContentPresenter>
                                        <controls:ImageButton ImageSource="{DynamicResource RemoveIcon}" ImageHeight="12" Grid.Column="1" Command="{Binding RemoveItemCommand, ElementName=userControl}" CommandParameter="{Binding}">
                                            <Interaction.Behaviors>
                                                <behaviours:ImageButtonConfirmDeleteBehaviour />
                                            </Interaction.Behaviors>
                                        </controls:ImageButton>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
