<Window xmlns="https://github.com/avaloniaui" xmlns:behaviours="clr-namespace:ClassicAssist.Shared.UI.Behaviours;assembly=ClassicAssist.Shared" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:virtualFolderBrowse="clr-namespace:ClassicAssist.Controls.VirtualFolderBrowse" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Controls.VirtualFolderBrowse.VirtualFolderBrowseWindow" mc:Ignorable="d" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.Folder_Browser}" Height="350" Width="400" Topmost="True" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/Theme.axaml" />
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DebugToolBarStyle.axaml" />
    </Window.Styles>
    <Window.DataContext>
        <virtualFolderBrowse:VirtualFolderBrowseViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10,10,10,0" Classes="ToolBarStyle1">
            <Button Content="{x:Static resources:Strings.New_Folder}" Command="{Binding NewFolderCommand}" />
        </StackPanel>
        <Grid Margin="10" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TreeView ItemsSource="{Binding Folders}">
                <TreeView.DataTemplates>
                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="virtualFolderBrowse:VirtualFolder">
                        <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
                <Interaction.Behaviors>
                    <virtualFolderBrowse:TreeViewExpandedBehaviour OnExpandedAction="{Binding ExpandCommand}" SelectedItem="{Binding SelectedItem}" />
                </Interaction.Behaviors>
            </TreeView>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,10,0,0">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Padding" Value="25,0" />
                    </Style>
                </StackPanel.Styles>
                <Button Content="{x:Static resources:Strings.Save}" Margin="0,0,10,0" Command="{Binding SaveCommand}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
                <Button Content="{x:Static resources:Strings.Close}">
                    <Interaction.Behaviors>
                        <behaviours:CloseOnClickBehaviour />
                    </Interaction.Behaviors>
                </Button>
            </StackPanel>
        </Grid>
        <ProgressBar IsIndeterminate="True" Grid.Row="2" IsVisible="{Binding IsWorking}" />
    </Grid>
</Window>
