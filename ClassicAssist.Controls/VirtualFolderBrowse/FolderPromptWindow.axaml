<Window xmlns="https://github.com/avaloniaui" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClassicAssist.Controls.VirtualFolderBrowse.FolderPromptWindow" mc:Ignorable="d" Topmost="True" Background="{DynamicResource ThemeWindowBackgroundBrush}" Title="{x:Static resources:Strings.New_Folder}" Height="150" Width="400" ExtendClientAreaToDecorationsHint="True" TransparencyLevelHint="AcrylicBlur" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared" xmlns:shared="clr-namespace:ClassicAssist.Shared.UI;assembly=ClassicAssist.Shared">
    <Window.Styles>
        <StyleInclude Source="avares://ClassicAssist.Shared/Resources/DarkTheme.xaml" />
    </Window.Styles>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="{x:Static resources:Strings.New_Folder}" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="TextBox" Text="{x:Static resources:Strings.New_Folder}" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Padding" Value="25,5" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static resources:Strings.OK}" Margin="0,0,10,0" Click="OKOnClick" />
            <Button Content="{x:Static resources:Strings.Cancel}" Click="CancelOnClick" />
        </StackPanel>
    </Grid>
</Window>
