            <SolidColorBrush x:Key="ComboBoxHoverBackgroundBrush" Color="{StaticResource SelectionColor1}" />
            <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="{StaticResource SelectionColor2}" />
