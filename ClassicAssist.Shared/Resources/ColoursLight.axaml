            <!-- ComboBox -->
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="ComboBoxNonEditableBackgroundBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="ComboBoxNonEditableHoverBackgroundBrush" />
