            <SolidColorBrush x:Key="ThemeDisabledForegroundBrush" Color="{StaticResource ForegroundColor3}" />
            <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D2D2D2" />
            <SolidColorBrush x:Key="ThemeInnerControlBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ThemeTabBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IconForegroundBrush" Color="#1A1A1A" />

            <!--
              Fluent theme resource overrides.
              FluentTheme (added in DarkTheme.axaml) provides control templates, but its default light/dark
              palette doesn't match the migrated WPF palette. These aliases remap Fluent's resource keys onto
              the palette above. They are declared after FluentTheme in DarkTheme.axaml, and Styles resource
              lookup consults later children first, so these win over Fluent's theme dictionaries.
            -->
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
            <StaticResource x:Key="SystemAccentColor" ResourceKey="SelectionColor2Emphasized" />
            <Color x:Key="SystemAccentColorLight1">#4FB8E8</Color>
            <Color x:Key="SystemAccentColorLight2">#7ACCEF</Color>
            <Color x:Key="SystemAccentColorLight3">#A5DFF5</Color>
            <Color x:Key="SystemAccentColorDark1">#1B7FB0</Color>
            <Color x:Key="SystemAccentColorDark2">#14608A</Color>
            <Color x:Key="SystemAccentColorDark3">#0D4663</Color>

            <!-- Button -->
            <StaticResource x:Key="ButtonBackground" ResourceKey="ButtonBackgroundBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ButtonHoverBackgroundBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ButtonPressBackgroundBrush" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ButtonDisabledBackgroundBrush" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="ButtonForegroundBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ButtonForegroundBrush" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="ButtonForegroundBrush" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="ButtonDisabledForegroundBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ButtonHoverBorderBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ButtonPressBorderBrush" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ButtonDisabledBorderBrush" />

            <!-- AccentButton -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="SelectionColor2Brush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="SelectionColor2EmphasizedBrush" />
